---
/**
 * KineticHeading — Cabeçalho brutalista e mecha para as seções:
 * - Numeração wireframe estilizada (estilo poster/artbook japonês de mecha)
 * - Tag técnica HUD com acento de cor EVA-01
 * - Headline com peso extremo e camadas pseudo-3D
 * - Suporta modo 'compact' para colunas laterais estreitas (evita sobreposição de layout)
 */
interface Props {
  index: string; // Ex: '01', '02', '03'
  tag: string;   // Ex: '// MISSION_DECK: FEATURED_PROJECTS'
  title: string;
  titleId?: string;
  description?: string;
  accent?: 'purple' | 'volt' | 'alert' | 'vermilion' | 'cyan';
  size?: 'normal' | 'compact';
  class?: string;
}

const {
  index,
  tag,
  title,
  titleId,
  description,
  accent = 'purple',
  size = 'normal',
  class: className = '',
} = Astro.props;

const accentColorClass = {
  purple: 'text-eva-purple-light border-eva-purple',
  volt: 'text-accent-volt border-accent-volt',
  alert: 'text-accent-alert border-accent-alert',
  vermilion: 'text-accent-alert border-accent-alert',
  cyan: 'text-eva-purple-light border-eva-purple',
}[accent];

const isCompact = size === 'compact';
const hasAction = Astro.slots.has('action');
---

<div class:list={['space-y-3 relative', className]}>
  <!-- Linha de identificação técnica HUD -->
  <div class="flex items-center gap-2.5 font-mono text-xs font-bold uppercase tracking-widest">
    <span class="inline-flex items-center justify-center px-2 py-0.5 bg-bg-surface border border-border-control text-text-primary shadow-hard-solid">
      SEC.{index}
    </span>
    <span class={accentColorClass}>{tag}</span>
    <span class="hidden sm:inline-block h-[1px] flex-1 bg-border-subtle" aria-hidden="true"></span>
  </div>

  <div class:list={['flex flex-col justify-between gap-4', !isCompact && 'lg:flex-row lg:items-end']}>
    <div class="space-y-2 max-w-[48rem]">
      <!-- Título com número de fundo estilizado -->
      <div class="relative">
        <span
          class:list={[
            'text-stroke-title font-display font-black select-none pointer-events-none opacity-15 absolute',
            isCompact
              ? 'text-5xl sm:text-6xl -top-5 -left-1'
              : 'text-6xl sm:text-8xl lg:text-9xl -top-8 sm:-top-12 -left-2',
          ]}
          aria-hidden="true"
        >
          {index}
        </span>
        <h2
          id={titleId}
          class:list={[
            'font-display font-black uppercase tracking-tight text-text-primary relative z-10 leading-[1.08]',
            isCompact ? 'text-2xl sm:text-3xl lg:text-3xl' : 'text-3xl sm:text-5xl lg:text-6xl',
          ]}
        >
          {title}
        </h2>
      </div>

      {
        description && (
          <p class="text-sm sm:text-base text-text-secondary leading-relaxed max-w-[42rem] font-medium font-sans">
            {description}
          </p>
        )
      }
    </div>

    {
      hasAction && (
        <div class="shrink-0 self-start lg:self-end">
          <slot name="action" />
        </div>
      )
    }
  </div>

  <!-- Faixa de corte gráfico EVA-01 -->
  <div class="w-full h-1 bg-gradient-to-r from-eva-purple via-accent-volt to-transparent opacity-70" aria-hidden="true"></div>
</div>

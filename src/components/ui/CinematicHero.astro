---
import ArcadeButton from './ArcadeButton.astro';
import AnimateOnScroll from '../motion/AnimateOnScroll.astro';
import StaggerContainer from '../motion/StaggerContainer.astro';
import StaggerItem from '../motion/StaggerItem.astro';
import RevealText from '../motion/RevealText.astro';

interface Props {
  techLine: string;
  linkedinUrl: string;
  lattesUrl: string;
}

const { techLine, linkedinUrl, lattesUrl } = Astro.props;
---

<section
  aria-labelledby="hero-title"
  class="relative min-h-[calc(100vh-4.5rem)] flex flex-col justify-between pt-8 pb-4 border-b-2 border-border-subtle overflow-hidden"
>
  <div class="space-y-8 relative z-10">
    <!-- Top HUD Bar de Entrada: Status EVA-01 e Coordenadas -->
    <div class="flex flex-wrap items-center justify-between gap-3 text-xs font-mono border-b border-border-subtle pb-3">
      <AnimateOnScroll preset="fade-right" translateX={-20} duration={450}>
        <div class="flex items-center gap-2">
          <span class="inline-block px-2 py-0.5 bg-eva-purple text-text-primary font-bold uppercase tracking-wider manga-tag-chamfer shadow-hard-solid">
            EVA-01 // TACTICAL_DECK
          </span>
          <span class="text-text-primary font-bold flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-accent-volt inline-block animate-pulse"></span>
            <span>STATUS: DISPATCH_READY</span>
          </span>
        </div>
      </AnimateOnScroll>

      <AnimateOnScroll preset="fade-left" translateX={20} duration={450} delay={80}>
        <div class="flex items-center gap-2 text-text-secondary">
          <span class="text-eva-purple-light" aria-hidden="true">●</span>
          <span>IF SUDESTE MG // CAMPUS RIO POMBA</span>
        </div>
      </AnimateOnScroll>
    </div>

    <!-- Composição Monumental Central: Headline Pseudo-3D e Painel Mecha -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">
      <!-- Coluna Principal (8 cols): Tipografia Monumental e Apresentação -->
      <div class="lg:col-span-8 space-y-6">
        <div class="space-y-1">
          <AnimateOnScroll preset="fade-up" translateY={12} duration={420} delay={100}>
            <p class="font-mono text-xs sm:text-sm font-bold uppercase tracking-widest text-accent-volt flex items-center gap-2">
              <span class="w-3 h-0.5 bg-eva-purple-light inline-block" aria-hidden="true"></span>
              <span>CIÊNCIA DA COMPUTAÇÃO // PESQUISA EM IA & ENGENHARIA DE SOFTWARE</span>
            </p>
          </AnimateOnScroll>

          <!-- Título Pseudo-3D Monumental com Camadas EVA-01 -->
          <div class="relative py-2">
            <h1
              id="hero-title"
              class="font-display font-black text-5xl sm:text-7xl lg:text-8xl xl:text-9xl uppercase tracking-tighter text-text-primary text-shadow-3d leading-[0.92] select-none"
            >
              <span class="block">JUAN</span>
              <span class="block text-eva-purple-light hover:text-accent-volt transition-colors cursor-default">
                GARCIA<span class="text-accent-volt">.</span>
              </span>
            </h1>

            <span
              class="text-stroke-title font-display font-black text-6xl sm:text-8xl lg:text-9xl uppercase tracking-tighter opacity-15 absolute -bottom-6 sm:-bottom-8 right-4 select-none pointer-events-none"
              aria-hidden="true"
            >
              01
            </span>
          </div>
        </div>

        <!-- Subtítulo e Manifesto Editorial Curto e Assertivo -->
        <RevealText
          as="p"
          text="Entre aplicativos mobile, pesquisa em aprendizado de máquina, jogos e docência, projeto soluções de software combinando rigor analítico e impacto prático."
          mode="mask"
          delay={240}
          duration={680}
          distance={20}
          class="font-sans text-lg sm:text-2xl font-bold text-text-primary leading-snug max-w-[44rem]"
        />

        <AnimateOnScroll preset="fade-up" translateY={16} duration={560} delay={320}>
          <p class="text-sm sm:text-base text-text-secondary leading-relaxed max-w-[42rem] font-medium font-sans">
            Graduando em Ciência da Computação e Técnico em Informática no IF Sudeste MG (Campus Rio Pomba).
            Autor de publicação científica em bioacústica no CoBICET e tutor de programação na CNA Digital e Kodland.
          </p>
        </AnimateOnScroll>

        <!-- Linha de Tecnologias em Chip Mecha com Link para Tech Loadout -->
        <AnimateOnScroll preset="fade-up" translateY={14} duration={520} delay={380}>
          <a
            href="#tech-loadout"
            class="inline-flex flex-wrap items-center gap-2 border-2 border-border-subtle hover:border-accent-volt bg-bg-panel px-3.5 py-2 shadow-hard-solid text-xs font-mono font-bold tracking-wider manga-tag-chamfer transition-all group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-volt text-text-primary"
            aria-label="Ir para a matriz completa de tecnologias e competências"
          >
            <span class="text-eva-purple-light group-hover:text-accent-volt transition-colors" aria-hidden="true">STACK:</span>
            <span>{techLine}</span>
            <span class="text-accent-volt font-bold group-hover:translate-y-0.5 transition-transform" aria-hidden="true">↓</span>
          </a>
        </AnimateOnScroll>

        <!-- Botões de Ação com Hierarquia EVA-01 -->
        <StaggerContainer stagger={60} baseDelay={420} class="pt-2 flex flex-wrap items-center gap-4">
          <StaggerItem index={0}>
            <ArcadeButton href="#projetos" variant="volt" size="lg">
              Ver projetos ►
            </ArcadeButton>
          </StaggerItem>

          <StaggerItem index={1}>
            <ArcadeButton href="#github" variant="purple" size="lg">
              Colaborações & GitHub ↗
            </ArcadeButton>
          </StaggerItem>

          <StaggerItem index={2}>
            <ArcadeButton href="#contato" variant="surface" size="lg">
              Contato ✉
            </ArcadeButton>
          </StaggerItem>
        </StaggerContainer>
      </div>

      <!-- Coluna Lateral (4 cols): Profile Deck Mecha -->
      <AnimateOnScroll
        as="aside"
        preset="fade-left"
        translateX={25}
        duration={640}
        delay={300}
        aria-label="Perfil do Desenvolvedor e Frentes Ativas"
        class="lg:col-span-4 border-2 border-border-subtle bg-bg-panel p-5 sm:p-6 shadow-hard-solid space-y-4 relative"
      >
        <div class="flex items-center justify-between border-b border-border-subtle pb-2 text-xs font-mono font-bold uppercase tracking-wider">
          <span class="text-accent-volt">// PROFILE_DECK</span>
          <span class="text-text-primary font-bold">GARCIA_JS</span>
        </div>

        <div class="space-y-1.5">
          <div class="text-[11px] font-mono text-eva-purple-light uppercase tracking-widest font-bold">
            01. FORMAÇÃO ACADÊMICA
          </div>
          <p class="font-display font-extrabold text-lg text-text-primary leading-tight uppercase">
            B.Sc. Ciência da Computação & Técnico Informática
          </p>
          <p class="text-xs font-mono text-text-secondary">
            IF Sudeste MG — Campus Rio Pomba (Cataguases, MG)
          </p>
        </div>

        <div class="space-y-1.5 pt-2 border-t border-border-subtle">
          <div class="text-[11px] font-mono text-eva-purple-light uppercase tracking-widest font-bold">
            02. FRENTES ATIVAS
          </div>
          <p class="text-xs font-sans text-text-secondary leading-relaxed font-medium">
            Engenharia web/mobile, pesquisa em bioacústica com CNNs/SVM, desenvolvimento de jogos autorais e docência de tecnologia na <strong class="text-text-primary font-bold">CNA Digital</strong> e <strong class="text-text-primary font-bold">Kodland</strong>.
          </p>
        </div>

        <div class="pt-3 border-t border-border-subtle flex flex-col gap-2.5">
          <a
            href={linkedinUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="arcade-btn-interactive px-3 py-2 border border-border-subtle bg-bg-surface hover:border-eva-purple hover:bg-bg-panel-raised font-mono text-xs font-bold uppercase flex items-center justify-between shadow-hard-solid transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-volt text-text-primary"
          >
            <span>LinkedIn // in/juan-silva-garcia</span>
            <span aria-hidden="true" class="text-accent-volt">↗</span>
          </a>

          <a
            href={lattesUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="arcade-btn-interactive px-3 py-2 border border-border-subtle bg-bg-surface hover:border-accent-volt hover:bg-bg-panel-raised font-mono text-xs font-bold uppercase flex items-center justify-between shadow-hard-solid transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-volt text-text-primary"
          >
            <span>Currículo Lattes (CNPq)</span>
            <span aria-hidden="true" class="text-accent-volt">↗</span>
          </a>
        </div>
      </AnimateOnScroll>
    </div>
  </div>
</section>

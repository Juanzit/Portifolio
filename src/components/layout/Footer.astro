---
import GraphicMarquee from '../ui/GraphicMarquee.astro';
import ArcadeButton from '../ui/ArcadeButton.astro';

const currentYear = new Date().getFullYear();
---

<footer class="mt-20 border-t-2 border-border-subtle bg-bg-surface relative overflow-hidden">
  <GraphicMarquee variant="dark" />

  <div class="max-w-[1200px] mx-auto px-4 sm:px-8 py-12 flex flex-col md:flex-row items-start md:items-center justify-between gap-8 relative z-10">
    <div class="space-y-2 max-w-[36rem]">
      <div class="flex items-center gap-2 text-xs font-mono font-bold uppercase tracking-wider text-eva-purple-light">
        <span class="w-2 h-2 bg-eva-purple inline-block" aria-hidden="true"></span>
        <span>// EVA-01 TACTICAL INTERFACE · TERMINAL_END</span>
      </div>

      <p class="font-display font-black text-2xl tracking-tight text-text-primary uppercase">
        Juan Silva Garcia
      </p>
      <p class="text-xs sm:text-sm text-text-secondary leading-relaxed font-mono">
        Graduando em Ciência da Computação e Técnico em Informática — IF Sudeste MG (Campus Rio Pomba).
        Pesquisa em Inteligência Artificial, Bioacústica e Sistemas de Software.
      </p>
    </div>

    <div class="flex flex-wrap items-center gap-3">
      <ArcadeButton
        href="https://github.com/Juanzit/Portifolio"
        target="_blank"
        rel="noopener noreferrer"
        size="sm"
        variant="surface"
      >
        Repo Portfólio ↗
      </ArcadeButton>

      <ArcadeButton
        href="/design-system/"
        size="sm"
        variant="purple"
      >
        /design-system ↗
      </ArcadeButton>

      <div class="font-mono text-xs text-text-secondary px-2">
        © {currentYear} GARCIA_JS
      </div>
    </div>
  </div>
</footer>

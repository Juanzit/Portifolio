---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-border-subtle bg-bg-canvas mt-16">
  <div class="max-w-[1120px] mx-auto px-4 sm:px-8 py-10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 text-[13px] leading-normal text-text-secondary">
    <div class="space-y-1">
      <p class="text-text-primary font-medium text-sm">
        Juan Silva Garcia · Cataguases, MG
      </p>
      <p>
        Graduando em Ciência da Computação — IF Sudeste MG (Campus Rio Pomba)
      </p>
    </div>

    <div class="flex flex-wrap items-center gap-x-4">
      <a
        href="https://github.com/Juanzit/Portifolio"
        target="_blank"
        rel="noopener noreferrer"
        class="min-h-[44px] inline-flex items-center text-text-secondary hover:text-text-primary transition-colors"
      >
        Código-fonte no GitHub ↗
      </a>
      <span aria-hidden="true">·</span>
      <a href="/design-system/" class="min-h-[44px] inline-flex items-center font-mono text-accent-text hover:underline">
        /design-system
      </a>
      <span aria-hidden="true">·</span>
      <span>© {currentYear}</span>
    </div>
  </div>
</footer>

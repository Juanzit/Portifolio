---
interface NavItem {
  label: string;
  code?: string;
  href: string;
}

interface Props {
  items: NavItem[];
}

const { items } = Astro.props;
---

<div class="relative" data-mobile-menu-root>
  <button
    type="button"
    id="mobile-menu-trigger"
    aria-expanded="false"
    aria-controls="mobile-menu-panel"
    aria-label="Abrir menu de navegação"
    class="min-h-[44px] min-w-[44px] px-3 inline-flex items-center justify-center gap-1.5 border-2 border-border-hard bg-bg-surface text-text-primary hover:bg-accent-volt-bg hover:text-text-on-volt transition-all cursor-pointer font-mono font-bold text-xs uppercase tracking-wider shadow-hard-solid focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-volt manga-tag-chamfer"
  >
    <span data-menu-label>MENU</span>
    <span class="text-eva-purple-light font-mono font-extrabold" data-menu-icon aria-hidden="true">[+]</span>
  </button>

  <div
    id="mobile-menu-panel"
    hidden
    role="region"
    aria-label="Navegação móvel"
    class="fixed inset-x-0 top-18 border-b-2 border-border-hard bg-bg-surface/98 backdrop-blur-xl z-50 shadow-2xl max-h-[calc(100dvh-4.5rem)] overflow-y-auto p-4 space-y-3"
  >
    <div class="flex items-center justify-between border-b border-border-subtle pb-2 text-[10px] font-mono text-text-secondary uppercase tracking-widest">
      <span>// EVA-01 TACTICAL // NAVIGATION</span>
      <span class="text-accent-volt font-bold">SYSTEM_READY</span>
    </div>

    <nav aria-label="Seções do portfólio" class="space-y-2">
      {
        items.map((item, idx) => (
          <a
            href={item.href}
            data-mobile-link
            class="min-h-[48px] px-4 py-3 flex items-center justify-between border-2 border-border-subtle bg-bg-panel hover:bg-eva-purple hover:text-text-primary text-sm font-display font-bold uppercase tracking-wider transition-all shadow-hard-solid group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-volt"
          >
            <div class="flex items-center gap-3">
              <span class="font-mono text-xs text-eva-purple-light group-hover:text-accent-volt font-bold">
                0{idx + 1}.
              </span>
              <span>{item.label}</span>
            </div>
            <span class="text-accent-volt font-mono text-xs" aria-hidden="true">
              →
            </span>
          </a>
        ))
      }
    </nav>
  </div>
</div>

<script>
  function setupMobileMenu() {
    const root = document.querySelector('[data-mobile-menu-root]');
    if (!root) return;

    const trigger = root.querySelector('#mobile-menu-trigger') as HTMLButtonElement | null;
    const panel = root.querySelector('#mobile-menu-panel') as HTMLElement | null;
    const label = root.querySelector('[data-menu-label]');
    const icon = root.querySelector('[data-menu-icon]');
    const links = root.querySelectorAll('[data-mobile-link]');

    if (!trigger || !panel) return;

    function openMenu() {
      panel!.hidden = false;
      trigger!.setAttribute('aria-expanded', 'true');
      trigger!.setAttribute('aria-label', 'Fechar menu de navegação');
      if (label) label.textContent = 'FECHAR';
      if (icon) icon.textContent = '[×]';
      const firstLink = panel!.querySelector('a') as HTMLElement | null;
      firstLink?.focus();
    }

    function closeMenu() {
      panel!.hidden = true;
      trigger!.setAttribute('aria-expanded', 'false');
      trigger!.setAttribute('aria-label', 'Abrir menu de navegação');
      if (label) label.textContent = 'MENU';
      if (icon) icon.textContent = '[+]';
    }

    function toggleMenu() {
      const isExpanded = trigger!.getAttribute('aria-expanded') === 'true';
      if (isExpanded) {
        closeMenu();
      } else {
        openMenu();
      }
    }

    trigger.onclick = toggleMenu;

    links.forEach((link) => {
      (link as HTMLElement).onclick = () => {
        closeMenu();
      };
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && trigger.getAttribute('aria-expanded') === 'true') {
        closeMenu();
        trigger.focus();
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupMobileMenu);
  } else {
    setupMobileMenu();
  }
</script>

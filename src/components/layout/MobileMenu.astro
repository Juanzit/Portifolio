---
interface NavItem {
  label: string;
  href: string;
}

interface Props {
  items: NavItem[];
}

const { items } = Astro.props;
---

<div class="md:hidden" data-mobile-menu-root>
  <button
    type="button"
    id="mobile-menu-trigger"
    aria-expanded="false"
    aria-controls="mobile-menu-panel"
    class="min-h-[44px] min-w-[44px] px-3.5 inline-flex items-center justify-center gap-2 border border-border-control bg-bg-surface text-text-primary hover:border-accent-primary transition-colors cursor-pointer text-[13px] leading-normal font-medium"
  >
    <span data-menu-label>Menu</span>
    <span class="sr-only"> de navegação</span>
    <span class="text-metric-accent font-mono font-bold" data-menu-icon aria-hidden="true">+</span>
  </button>

  <div
    id="mobile-menu-panel"
    hidden
    class="fixed inset-x-0 top-16 border-b border-border-subtle bg-bg-canvas z-50 shadow-2xl max-h-[calc(100dvh-4rem)] overflow-y-auto"
  >
    <nav aria-label="Navegação principal (mobile)" class="max-w-[1120px] mx-auto px-4 py-5 space-y-2">
      {
        items.map((item) => (
          <a
            href={item.href}
            data-mobile-link
            class="min-h-[44px] px-4 py-3 flex items-center justify-between border border-border-subtle bg-bg-surface hover:border-accent-primary text-sm text-text-primary transition-colors"
          >
            <span>{item.label}</span>
            <span class="text-accent-text text-sm" aria-hidden="true">→</span>
          </a>
        ))
      }
      <div class="pt-3 mt-3 border-t border-border-subtle flex items-center justify-between text-[13px] leading-normal text-text-secondary">
        <span>Identidade visual</span>
        <a
          href="/design-system/"
          data-mobile-link
          class="min-h-[44px] inline-flex items-center font-mono text-accent-text hover:underline"
        >
          /design-system
        </a>
      </div>
    </nav>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-mobile-menu-root]');
  if (root) {
    const trigger = root.querySelector<HTMLButtonElement>('#mobile-menu-trigger');
    const panel = root.querySelector<HTMLElement>('#mobile-menu-panel');
    const icon = root.querySelector<HTMLElement>('[data-menu-icon]');
    const label = root.querySelector<HTMLElement>('[data-menu-label]');
    const links = root.querySelectorAll<HTMLAnchorElement>('[data-mobile-link]');

    const setMenuState = (isOpen: boolean) => {
      if (!trigger || !panel || !icon || !label) return;
      trigger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      panel.hidden = !isOpen;
      icon.textContent = isOpen ? '×' : '+';
      label.textContent = isOpen ? 'Fechar' : 'Menu';
    };

    trigger?.addEventListener('click', () => {
      setMenuState(trigger.getAttribute('aria-expanded') !== 'true');
    });

    links.forEach((link) => {
      link.addEventListener('click', () => setMenuState(false));
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && trigger?.getAttribute('aria-expanded') === 'true') {
        setMenuState(false);
        trigger.focus();
      }
    });

    window.matchMedia('(min-width: 48rem)').addEventListener('change', (e) => {
      if (e.matches) setMenuState(false);
    });
  }
</script>

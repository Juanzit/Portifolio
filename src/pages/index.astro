          </div>

          <!-- Destaque para a Publicação Principal (CoBICET / EAMC) -->
          <div class="border-2 border-eva-purple bg-bg-panel p-5 shadow-hard-solid space-y-2">
            <div class="flex items-baseline justify-between gap-2">
              <h3 class="font-mono text-xs font-bold text-accent-volt uppercase tracking-wider">

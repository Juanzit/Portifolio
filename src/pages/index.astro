---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

const academicAndCommunityProjects = [
  {
    category: 'Pesquisa & Algoritmos',
    title: 'PCMRC — Caminho Mínimo com Restrição de Recursos',
    stack: 'Java · Simulated Annealing · Pesquisa Operacional',
    summary:
      'Implementação da meta-heurística Simulated Annealing (Têmpera Simulada) com operador de vizinhança Cut-and-Reconnect e gerador automático de instâncias de benchmark para resolver o Problema do Caminho Mínimo com Restrição de Recursos em grafos.',
    href: 'https://github.com/Juanzit/Problema-do-Caminho-M-nimo-com-Restri-es-de-Recursos-PCMRC-',
    linkLabel: 'Repositório no GitHub ↗',
  },
  {
    category: 'Engenharia de Software',
    title: 'Viga-Mestre — Engenharia de Requisitos & Modelagem UML',
    stack: 'Requisitos · Arquitetura · 16 Diagramas UML',
    summary:
      'Modelagem completa do ciclo de vida de empreendimentos imobiliários (da aquisição do terreno à execução e venda de unidades), composta por Documento de Requisitos e 16 diagramas UML (Classes, Caso de Uso, Sequência, Estado, Atividade, Implantação e Gantt).',
    href: 'https://github.com/Juanzit/Viga-Mestre',
    linkLabel: 'Diagramas e documentação ↗',
  },
  {
    category: 'Teoria dos Grafos',
    title: 'Emparelhamento Máximo em Grafos (Hopcroft-Karp)',
    stack: 'Python · C++ · Grafos Bipartidos & Redes Complexas',
    summary:
      'Implementação do algoritmo de Hopcroft-Karp para correspondências máximas em grafos bipartidos e conversão de grafos direcionados para identificação de nós de controle em redes complexas.',
    href: 'https://github.com/Juanzit/Trabalho-grafos',
    linkLabel: 'Repositório no GitHub ↗',
  },
  {
    category: 'Ensino & Comunidade',
    title: 'Minicurso React Native — Do Zero ao APK',
    stack: 'JavaScript · React Native · 16 Videoaulas Abertas',
    summary:
      'Série aberta de 16 videoaulas práticas ensinando desenvolvimento mobile com JavaScript e React Native desde a configuração do ambiente até a geração do APK, produzida em projeto de extensão no IF Sudeste MG.',
    href: 'https://www.youtube.com/@CURSORNFIRP',
    linkLabel: 'Canal no YouTube ↗',
  },
  {
    category: 'Ensino & Comunidade',
    title: 'Roadmap Python',
    stack: 'Python · Comunidade Acadêmica & Materiais de Estudo',
    summary:
      'Iniciativa acadêmica voltada ao compartilhamento de trilhas de estudo, códigos comentados e aulas abertas sobre programação em Python.',
    href: 'https://github.com/RoadMapPython',
    linkLabel: 'Organização no GitHub ↗',
  },
];

const experiences = [
  {
    period: '04/2026 — Atual',
    role: 'Professor Tutor de Programação e Tecnologia',
    org: 'CNA Digital',
    meta: '15h semanais',
    description:
      'Condução de trilhas de lógica de programação, Scratch, Construct, modelagem 3D com Blender e SculptGL, Unity, Roblox Studio, React, Python, Ciência de Dados e Inteligência Artificial.',
  },
  {
    period: '06/2025 — Atual',
    role: 'Professor Tutor de Programação (Python, Lua & Scratch)',
    org: 'Kodland',
    meta: '12h semanais · EdTech Internacional',
    description:
      'Ensino prático para alunos de 8 a 16 anos em Scratch, Python (Flask, POO e bancos de dados) e Roblox Studio/Lua, aplicando aprendizagem baseada em projetos (PBL), Scrum e Git/GitHub.',
  },
  {
    period: '06/2025 — 06/2026',
    role: 'Pesquisador em Inteligência Artificial',
    org: 'IF Sudeste MG — Campus Rio Pomba',
    meta: 'Iniciação Científica',
    description:
      'Desenvolvimento de pipelines de pré-processamento acústico e modelos supervisionados (CNN/RNC, SVM/MVS e GMM-HMM/MOM) para identificação automática de 136 espécies de aves ameaçadas de extinção.',
  },
  {
    period: '08/2024 — 01/2026',
    role: 'Desenvolvedor Mobile Júnior — Projeto ShapeMeApp',
    org: 'IF Sudeste MG — Campus Rio Pomba',
    meta: 'Projeto de Extensão',
    description:
      'Atuação no projeto "Emagreça na Musculação no IF Sudeste MG — Campus Rio Pomba", realizando evolução mobile em React Native/Expo, modelagem NoSQL no Firebase, testes de usabilidade, QA e gestão com Jira e GitHub.',
  },
  {
    period: '06/2022 — 11/2025',
    role: 'Membro de Projetos, Validação e Prototipação',
    org: 'EmComp — Empresa Júnior de Computação (IF Sudeste MG)',
    meta: '100 horas certificadas',
    description:
      'Desenvolvimento web (incluindo o site institucional da Labclin), prototipação de sites e aplicativos, validação de UX/UI e organização de eventos técnicos junto ao Núcleo da Mata.',
  },
];

const education = [
  {
    period: '2022 — Em andamento',
    degree: 'Bacharelado em Ciência da Computação',
    institution: 'Instituto Federal do Sudeste de Minas Gerais (IF Sudeste MG — Campus Rio Pomba)',
    detail:
      'Pesquisa aplicada em Inteligência Artificial, engenharia de software, estruturas de dados, grafos e desenvolvimento mobile/web.',
  },
  {
    period: '2019 — 2021 (Registro Lattes: 2019 — 2022)',
    degree: 'Técnico em Informática',
    institution: 'Instituto Federal do Sudeste de Minas Gerais (IF Sudeste MG — Campus Rio Pomba)',
    detail:
      'Formação técnica de base em lógica de programação, redes, bancos de dados, manutenção e desenvolvimento de sistemas.',
  },
];

const publications = [
  {
    year: '2026',
    dateDetail: '05/08/2026',
    type: 'Trabalho Completo em Anais · ISSN 2764-0582',
    title: 'Detecção Acústica de Aves Ameaçadas Utilizando Aprendizado de Máquina',
    venue: 'Anais do VII Congresso Brasileiro Interdisciplinar em Ciência e Tecnologia (VII CoBICET) — Editora Even3',
    authors: 'GARCIA, J. S.; COELHO, M. A. N.',
  },
  {
    year: '2026',
    dateDetail: '2026',
    type: 'Apresentação de Trabalho Científico',
    title: 'Detecção Acústica de Aves Ameaçadas Utilizando Aprendizado de Máquina',
    venue: 'XVIII Encontro Acadêmico de Modelagem Computacional (EAMC)',
    authors: 'Juan Silva Garcia e Maurício Archanjo Nunes Coelho',
  },
  {
    year: '2025',
    dateDetail: '2025',
    type: 'Trabalho Apresentado em Simpósio Institucional',
    title: 'Evolução de Software em Ambientes Acadêmicos: O ShapeMeApp e a Integração de Feedbacks Reais no Campus Rio Pomba',
    venue: 'VII Simpósio de Ensino, Pesquisa e Extensão (VII SIMEPE) — IF Sudeste MG',
    authors: 'Juan Silva Garcia, Gustavo Vaz Teixeira, Sérgio Muinhos Barroso Lima e João Batista Ferreira Júnior',
  },
];

const certificationsAndExtension = [
  {
    period: '2022 — 2025',
    title: 'Certificação de Atuação em Empresa Júnior (EmComp)',
    issuer: 'IF Sudeste MG — Campus Rio Pomba',
    workload: '100 horas certificadas',
  },
  {
    period: '03/2025 — 08/2025',
    title: 'Monitoria Voluntária — Linguagens Formais e Autômatos',
    issuer: 'IF Sudeste MG — Campus Rio Pomba',
    workload: 'Ensino superior',
  },
  {
    period: '2025',
    title: 'Ministrante de Minicurso Presencial: React com Firebase',
    issuer: 'IF Sudeste MG — Campus Rio Pomba',
    workload: 'Formação prática',
  },
  {
    period: '12/2023 — 08/2024',
    title: 'Instrutor de Desenvolvimento Mobile (JavaScript & React Native)',
    issuer: 'IF Sudeste MG — Projeto de Extensão',
    workload: '16 videoaulas gravadas',
  },
  {
    period: '2020',
    title: 'Voluntário no Curso "Python Básico pra Quem Tem Pressa"',
    issuer: 'IF Sudeste MG — Projeto de Extensão',
    workload: 'Extensão comunitária',
  },
];
---

<BaseLayout
  title="Juan Silva Garcia — Caderno de Projetos, Pesquisa & Software"
  description="Portfólio pessoal e acadêmico de Juan Silva Garcia (GARCIA, J. S.). Estudante de Ciência da Computação e Técnico em Informática no IF Sudeste MG (Campus Rio Pomba), explorando aplicações mobile e web, pesquisa em bioacústica com aprendizado de máquina, jogos e ensino de programação."
>
  <Header />

  <main id="main-content" tabindex="-1" class="max-w-[1120px] mx-auto px-4 sm:px-8">
    <!-- 1. HERO EDITORIAL (ASSIMÉTRICO, HUMANO E DIRETO) -->
    <section aria-labelledby="hero-heading" class="py-14 sm:py-24 border-b border-border-subtle">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-end">
        <div class="lg:col-span-8 space-y-6">
          <p class="text-[13px] leading-normal font-mono text-accent-text tracking-wide">
            Cataguases, MG · IF Sudeste MG — Campus Rio Pomba
          </p>

          <h1
            id="hero-heading"
            class="font-display text-4xl sm:text-6xl font-medium tracking-[-0.02em] text-text-primary leading-[1.08]"
          >
            Olá, eu sou o Juan.
          </h1>

          <p class="font-display italic text-2xl sm:text-3xl text-text-primary/90 leading-[1.32] max-w-[34ch]">
            Entre aplicativos, pesquisa, jogos e ensino, venho explorando diferentes possibilidades da computação.
          </p>

          <p class="text-base sm:text-lg text-text-secondary leading-[1.7] max-w-[60ch]">
            Estudo Ciência da Computação no IF Sudeste MG. Neste portfólio, reúno projetos que desenvolvi e trabalhos
            em que colaborei, mostrando os problemas, as soluções e o que aprendi em cada experiência.
          </p>

          <div class="pt-2 flex flex-wrap items-center gap-3.5">
            <a
              href="#projetos"
              class="min-h-[44px] px-6 py-2.5 inline-flex items-center justify-center bg-accent-solid hover:bg-accent-solid-hover text-white font-medium text-sm transition-colors"
            >
              Conhecer os projetos
            </a>
            <a
              href="#github"
              class="min-h-[44px] px-6 py-2.5 inline-flex items-center justify-center bg-bg-surface hover:bg-bg-elevated text-text-primary border border-border-control hover:border-accent-solid font-medium text-sm transition-colors"
            >
              Colaborações & GitHub
            </a>
            <a
              href="#contato"
              class="min-h-[44px] px-4 py-2.5 inline-flex items-center justify-center text-sm font-medium text-accent-text hover:underline"
            >
              Entrar em contato →
            </a>
          </div>
        </div>

        <!-- Coluna de Margem (Nota de Caderno de Campo, sem aspecto de dashboard) -->
        <aside aria-label="Síntese de formação e atuação" class="lg:col-span-4 border-l-2 border-accent-solid pl-6 space-y-5">
          <div class="space-y-1">
            <div class="text-[13px] leading-normal font-mono text-text-secondary">Formação no IF Sudeste MG</div>
            <p class="font-display text-lg font-medium text-text-primary leading-snug">
              Bacharelado em Ciência da Computação & Técnico em Informática
            </p>
          </div>

          <div class="space-y-1">
            <div class="text-[13px] leading-normal font-mono text-text-secondary">Frentes de Trabalho</div>
            <p class="text-sm text-text-secondary leading-relaxed">
              Aplicações mobile e web, pesquisa científica em bioacústica com aprendizado de máquina, desenvolvimento de
              jogos e docência em programação na <strong class="text-text-primary font-medium">CNA Digital</strong> e na <strong class="text-text-primary font-medium">Kodland</strong>.
            </p>
          </div>

          <div class="pt-1">
            <a
              href="http://lattes.cnpq.br/9434044887106048"
              target="_blank"
              rel="noopener noreferrer"
              class="min-h-[44px] inline-flex items-center text-[13px] leading-normal font-mono text-metric-accent hover:underline"
            >
              Currículo Lattes (CNPq) ↗
            </a>
          </div>
        </aside>
      </div>
    </section>

    <!-- 2. QUATRO PROJETOS PRINCIPAIS (CADA UM COM COMPOSIÇÃO PRÓPRIA) -->
    <section id="projetos" aria-labelledby="projetos-heading" class="py-16 sm:py-24 border-b border-border-subtle space-y-20">
      <div class="max-w-[64ch] space-y-3">
        <p class="text-[13px] leading-normal font-mono text-accent-text">Trabalhos Principais</p>
        <h2
          id="projetos-heading"
          class="font-display text-3xl sm:text-4xl font-medium tracking-[-0.015em] text-text-primary leading-tight"
        >
          Quatro projetos, quatro problemas diferentes
        </h2>
        <p class="text-base text-text-secondary leading-relaxed">
          De uma plataforma comercial em produção e um ecossistema mobile universitário à pesquisa em inteligência
          artificial e à construção de um jogo autoral.
        </p>
      </div>

      <!-- PROJETO I: LUNDGREN ATELIER (VITRINE EDITORIAL 12 COLUNAS COM CAPTURA REAL) -->
      <article class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center pt-4 border-t border-border-subtle">
        <div class="lg:col-span-5 space-y-5">
          <div class="flex items-center justify-between gap-2 text-[13px] leading-normal font-mono">
            <span class="text-accent-text">Desenvolvimento Web · Produção</span>
            <span class="text-text-secondary">2025 — 2026</span>
          </div>

          <h3 class="font-display text-3xl sm:text-4xl font-medium text-text-primary leading-tight">
            Lundgren Atelier
          </h3>

          <p class="text-sm sm:text-base text-text-secondary leading-relaxed">
            Desenvolvimento e publicação do site oficial do Lundgren Atelier. O desafio foi estruturar uma vitrine
            autoral rápida e responsiva em <strong class="text-text-primary font-medium">Astro</strong> e <strong class="text-text-primary font-medium">Tailwind CSS</strong>,
            integrada ao <strong class="text-text-primary font-medium">Sanity.io (Headless CMS)</strong> para gestão de
            obras, com scripts em <strong class="text-text-primary font-medium">Node.js</strong> para migração do acervo
            e publicação contínua no <strong class="text-text-primary font-medium">Cloudflare Pages</strong>.
          </p>

          <div class="pt-2 border-t border-border-subtle space-y-3">
            <div class="flex flex-wrap gap-2 text-[13px] leading-normal font-mono text-text-secondary">
              <span>Astro</span>
              <span aria-hidden="true">·</span>
              <span>Sanity.io</span>
              <span aria-hidden="true">·</span>
              <span>Tailwind CSS</span>
              <span aria-hidden="true">·</span>
              <span>Node.js</span>
              <span aria-hidden="true">·</span>
              <span>Cloudflare Pages</span>
            </div>

            <div>
              <a
                href="https://lundgren-atelier.com/"
                target="_blank"
                rel="noopener noreferrer"
                class="min-h-[44px] inline-flex items-center text-sm font-medium text-accent-text hover:underline"
              >
                Visitar lundgren-atelier.com ↗
              </a>
            </div>
          </div>
        </div>

        <div class="lg:col-span-7">
          <figure class="border border-border-control/50 bg-bg-surface shadow-sm overflow-hidden">
            <div class="px-4 py-2 border-b border-border-subtle bg-bg-elevated flex items-center justify-between text-[13px] leading-normal font-mono text-text-secondary">
              <div class="flex items-center gap-1.5" aria-hidden="true">
                <span class="w-2.5 h-2.5 rounded-full bg-border-control/60"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-border-control/60"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-border-control/60"></span>
              </div>
              <span>https://lundgren-atelier.com/</span>
              <span>Em produção</span>
            </div>
            <img
              src="/images/projetos/lundgren-atelier-home.png"
              alt="Captura real da página inicial do site Lundgren Atelier em produção"
              width="1440"
              height="900"
              loading="eager"
              class="w-full h-auto block"
            />
          </figure>
        </div>
      </article>

      <!-- PROJETO II: BIOACÚSTICA (LÂMINA DE PESQUISA CIENTÍFICA + PALCO ESCURO PONTUAL) -->
      <article class="pt-12 border-t border-border-subtle space-y-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          <div class="lg:col-span-6 space-y-4">
            <div class="flex flex-wrap items-center gap-3 text-[13px] leading-normal font-mono">
              <span class="text-metric-accent font-medium">Pesquisa Científica em IA · VII CoBICET (2026)</span>
              <span class="text-text-secondary">ISSN 2764-0582</span>
            </div>

            <h3 class="font-display text-3xl sm:text-4xl font-medium text-text-primary leading-tight">
              Detecção Acústica de Aves Ameaçadas Utilizando Aprendizado de Máquina
            </h3>

            <p class="text-sm sm:text-base text-text-secondary leading-relaxed">
              Pesquisa de iniciação científica e TCC desenvolvida no IF Sudeste MG em coautoria com o Prof. Maurício
              Archanjo Nunes Coelho. Investigamos como identificar automaticamente <strong class="text-text-primary font-medium">136 espécies de aves ameaçadas</strong> a
              partir de gravações do repositório <strong class="text-text-primary font-medium">Xeno-Canto</strong>,
              extraindo <strong class="text-text-primary font-medium">Espectrogramas Mel</strong> e coeficientes <strong class="text-text-primary font-medium">MFCC</strong> para
              avaliar três famílias de classificadores: <strong class="text-text-primary font-medium">SVM (MVS)</strong>,
              <strong class="text-text-primary font-medium">GMM-HMM (MOM)</strong> e <strong class="text-text-primary font-medium">Redes Neurais Convolucionais (CNN / RNC)</strong>.
            </p>

            <div class="pt-2 flex flex-wrap items-center gap-6">
              <a
                href="http://lattes.cnpq.br/9434044887106048"
                target="_blank"
                rel="noopener noreferrer"
                class="min-h-[44px] inline-flex items-center text-sm font-medium text-accent-text hover:underline"
              >
                Ver publicação no Currículo Lattes ↗
              </a>
              <span class="text-[13px] leading-normal font-mono text-text-secondary">
                Código-fonte do TCC em organização para publicação
              </span>
            </div>
          </div>

          <!-- Palco Científico de Alto Contraste (Elemento Pontual da Direção 2) -->
          <div class="lg:col-span-6 bg-stage-bg text-stage-text border border-stage-border p-6 sm:p-8 space-y-6">
            <div class="flex flex-wrap items-center justify-between gap-2 border-b border-stage-border pb-3 text-[13px] leading-normal font-mono">
              <span class="text-stage-amber">DESENHO EXPERIMENTAL · 136 ESPÉCIES</span>
              <span class="text-stage-muted">XENO-CANTO · MEL & MFCC</span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="border border-stage-border bg-stage-surface p-4 space-y-2">
                <div class="text-[13px] leading-normal font-mono text-stage-muted">01 · LINHA DE BASE</div>
                <h4 class="font-display text-lg font-medium text-stage-text">Cenário A (Controle)</h4>
                <p class="text-[13px] leading-relaxed text-stage-muted">
                  Configuração inicial de referência para avaliar o comportamento dos classificadores sobre os sinais
                  acústicos sem o refinamento proposto.
                </p>
              </div>

              <div class="border border-stage-amber/60 bg-stage-surface p-4 space-y-2">
                <div class="text-[13px] leading-normal font-mono text-stage-amber">02 · CONFIGURAÇÃO REFINADA</div>
                <h4 class="font-display text-lg font-medium text-stage-text">Cenário B (Proposto)</h4>
                <p class="text-[13px] leading-relaxed text-stage-muted">
                  Pipeline espectral refinado avaliado com SVM, GMM-HMM e CNN, no qual a <strong class="text-stage-text font-medium">CNN alcançou F1-weighted de 0,82</strong>.
                </p>
              </div>
            </div>

            <div class="pt-2 border-t border-stage-border flex flex-wrap items-center justify-between gap-3 text-[13px] leading-normal font-mono">
              <span class="text-stage-green">Resultado CNN (Cenário B): F1-weighted = 0,82</span>
              <span class="text-stage-muted">Anais VII CoBICET & XVIII EAMC</span>
            </div>
          </div>
        </div>
      </article>

      <!-- PROJETO III: SHAPEMEAPP (ESTUDO DE CASO DE EXTENSÃO & ARQUITETURA MULTI-MÓDULO) -->
      <article class="pt-12 border-t border-border-subtle grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">
        <div class="lg:col-span-6 space-y-4">
          <div class="flex flex-wrap items-center gap-3 text-[13px] leading-normal font-mono">
            <span class="text-accent-text">Desenvolvimento Mobile & Extensão · IF Sudeste MG</span>
            <span class="text-text-secondary">2024 — 2026</span>
          </div>

          <h3 class="font-display text-3xl sm:text-4xl font-medium text-text-primary leading-tight">
            ShapeMeApp
          </h3>

          <p class="text-sm sm:text-base text-text-secondary leading-relaxed">
            Ecossistema desenvolvido no projeto de extensão <em class="text-text-primary">"Emagreça na Musculação no IF Sudeste MG — Campus Rio Pomba"</em>.
            O sistema resolve o acompanhamento diário de treinos e avaliações físicas por meio de três aplicações
            integradas (<strong class="text-text-primary font-medium">Aluno</strong>, <strong class="text-text-primary font-medium">Professor</strong> e <strong class="text-text-primary font-medium">Coordenador</strong>) e
            uma versão web responsiva com <strong class="text-text-primary font-medium">Expo Router</strong>.
          </p>

          <p class="text-sm text-text-secondary leading-relaxed">
            Atuei na evolução das interfaces em <strong class="text-text-primary font-medium">React Native</strong>, na
            modelagem NoSQL no <strong class="text-text-primary font-medium">Firebase (Auth & Firestore)</strong>, na
            implementação dos cálculos de carga de treinamento (<strong class="text-text-primary font-medium">CIT, Monotonia e Strain</strong>) e nos ciclos de
            testes de usabilidade e QA com usuários reais — trabalho apresentado no <strong class="text-text-primary font-medium">VII SIMEPE (2025)</strong>.
          </p>

          <div class="pt-2 flex flex-wrap items-center gap-5">
            <a
              href="https://github.com/Juanzit/ShapeMeApp"
              target="_blank"
              rel="noopener noreferrer"
              class="min-h-[44px] inline-flex items-center text-sm font-medium text-accent-text hover:underline"
            >
              Monorepo no GitHub ↗
            </a>
            <a
              href="https://github.com/Juanzit/SmaAlunoWeb"
              target="_blank"
              rel="noopener noreferrer"
              class="min-h-[44px] inline-flex items-center text-sm font-medium text-accent-text hover:underline"
            >
              Módulo Web (SmaAlunoWeb) ↗
            </a>
            <a
              href="https://github.com/Juanzit/SMA_Professor"
              target="_blank"
              rel="noopener noreferrer"
              class="min-h-[44px] inline-flex items-center text-sm font-medium text-accent-text hover:underline"
            >
              Módulo Professor ↗
            </a>
          </div>
        </div>

        <div class="lg:col-span-6 bg-bg-surface border border-border-subtle p-6 sm:p-7 space-y-5">
          <div class="flex items-center justify-between border-b border-border-subtle pb-3 text-[13px] leading-normal font-mono">

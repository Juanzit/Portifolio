            </span>
          </div>
        </MangaPanel>
      </div>

      <!-- GRADE 2x2 COMPACTA: OUTROS PROJETOS & EXPERIÊNCIAS DE ENSINO -->
      <div class="space-y-4">
        <div class="flex items-center justify-between text-xs font-mono font-bold uppercase text-text-secondary border-b border-border-subtle pb-2">
          <span class="text-eva-purple-light">// COMPACT_MISSIONS: EXPANDED_RECORD</span>
          <span>4 INICIATIVAS</span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {
            compactOtherProjects.map((item) => (
              <div class="border-2 border-border-subtle hover:border-eva-purple bg-bg-panel p-5 space-y-3 shadow-hard-solid transition-colors">
                <div class="flex items-center justify-between gap-2 text-xs font-mono font-bold uppercase">
                  <span class="px-2 py-0.5 bg-bg-surface border border-border-subtle text-accent-volt">
                    {item.category}
                  </span>
                  <span class="text-text-secondary">{item.stack}</span>
                </div>

                <h4 class="font-display font-black text-xl text-text-primary uppercase tracking-tight">
                  {item.title}
                </h4>

                <p class="text-xs sm:text-sm text-text-secondary leading-relaxed font-sans font-medium">
                  {item.shortSummary}
                </p>

                <div class="pt-2 border-t border-border-subtle flex items-center justify-between gap-2 text-xs font-mono font-bold">
                  <span class="text-text-secondary">{item.stack}</span>
                  <ArcadeButton
                    href={item.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    size="sm"
                    variant="surface"
                  >
                    {item.linkLabel}
                  </ArcadeButton>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </SectionTransition>

    <!-- 4. RESUMO DA TRAJETÓRIA (JRPG QUESTLINE PROGRESSION) -->
    <SectionTransition id="trajetoria" aria-labelledby="trajetoria-title" class="space-y-10 scroll-mt-24">
      <StickyStorySection>
        <!-- Coluna Esquerda: Formação e Publicação (Constrained para evitar sobreposição) -->
        <div slot="sticky" class="space-y-6 pr-0 lg:pr-4">
          <KineticHeading
            index="03"
            tag="// CAREER_TREE & FORMATION"
            title="Formação e Trajetória"
            titleId="trajetoria-title"
            accent="volt"
            size="compact"
          />

          <!-- Formação Acadêmica no IF Sudeste MG -->
          <div class="border-2 border-border-subtle bg-bg-panel p-5 shadow-hard-solid space-y-3">
            <h3 class="font-mono text-xs font-bold text-accent-volt uppercase tracking-wider">
              // FORMAÇÃO · IF SUDESTE MG (CAMPUS RIO POMBA)
            </h3>
            <ul class="space-y-2 text-xs sm:text-sm">
              {
                education.map((edu) => (
                  <li class="flex items-baseline justify-between gap-3 border-b border-border-subtle pb-1.5 last:border-b-0 last:pb-0">

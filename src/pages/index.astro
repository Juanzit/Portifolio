---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

import CinematicHero from '../components/ui/CinematicHero.astro';
import KineticHeading from '../components/ui/KineticHeading.astro';
import ArcadeButton from '../components/ui/ArcadeButton.astro';
import PerspectiveCard from '../components/ui/PerspectiveCard.astro';
import MangaPanel from '../components/ui/MangaPanel.astro';
import GraphicMarquee from '../components/ui/GraphicMarquee.astro';
import TechLoadoutSection from '../components/ui/TechLoadoutSection.astro';

import StaggerContainer from '../components/motion/StaggerContainer.astro';
import StaggerItem from '../components/motion/StaggerItem.astro';
import ParallaxSection from '../components/motion/ParallaxSection.astro';
import StickyStorySection from '../components/motion/StickyStorySection.astro';
import SectionTransition from '../components/motion/SectionTransition.astro';

import {
  heroTechLine,
  archFlowProject,
  bladeOfAlbaiaProject,
  compactOtherProjects,
  featuredExperiences,
  education,
  contactLinks,
} from '../data/portfolio';
---

<BaseLayout
  title="Juan Silva Garcia — Caderno de Projetos, Pesquisa & Software // EVA-01 Tactical Interface"
  description="Portfólio de engenharia de software, pesquisa em IA/bioacústica e desenvolvimento mobile de Juan Silva Garcia (IF Sudeste MG) com arquitetura EVA-01 Tactical Interface."
>
  <Header />

  <main id="main-content" tabindex="-1" class="max-w-[1140px] mx-auto px-4 sm:px-6 lg:px-8 space-y-20 lg:space-y-24 focus:outline-none">
    <!-- 1. HERO PÔSTER MONUMENTAL CINEMATOGRÁFICO -->
    <CinematicHero
      techLine={heroTechLine}
      linkedinUrl={contactLinks.linkedinUrl}
      lattesUrl={contactLinks.lattesUrl}
    />

    <!-- TECH LOADOUT // EVA-01 SYSTEM -->
    <TechLoadoutSection />

    <!-- 2. QUATRO PROJETOS PRINCIPAIS (#projetos) -->
    <SectionTransition id="projetos" aria-labelledby="projetos-title" class="space-y-12 scroll-mt-24">
      <KineticHeading
        index="01"
        tag="// MISSION_DECK: PRIMARY_WORKS"
        title="Quatro Projetos, Quatro Problemas"
        titleId="projetos-title"
        description="De uma vitrine comercial em produção a um ecossistema universitário, pesquisa com aprendizado de máquina e jogo autoral."
        accent="purple"
      >
        <div slot="action" class="hidden sm:flex items-center gap-2">
          <span class="text-xs font-mono font-bold text-accent-volt uppercase">[ EVA-01 // 04 MISSIONS ]</span>
        </div>
      </KineticHeading>

      <!-- PROJETO I: LUNDGREN ATELIER (PRODUÇÃO / ECOMMERCE EDITORIAL) -->
      <PerspectiveCard maxTilt={5}>
        <article class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          <div class="lg:col-span-5 space-y-4">
            <div class="flex items-center justify-between gap-2 text-xs font-mono font-bold uppercase">
              <span class="inline-block px-2.5 py-0.5 bg-accent-volt text-text-on-volt font-bold manga-tag-chamfer shadow-hard-solid">
                WEB // PRODUCTION
              </span>
              <span class="text-text-secondary">2025 — 2026</span>
            </div>

            <h3 class="font-display font-black text-3xl sm:text-4xl text-text-primary uppercase tracking-tight">
              Lundgren Atelier
            </h3>

            <p class="text-sm sm:text-base text-text-secondary leading-relaxed font-sans font-medium">
              Desenvolvimento e publicação do site oficial do Lundgren Atelier. Estruturei uma vitrine autoral rápida e
              responsiva em <strong class="text-text-primary font-bold">Astro</strong> e <strong class="text-text-primary font-bold">Tailwind CSS</strong>,
              integrada ao <strong class="text-text-primary font-bold">Sanity.io (Headless CMS)</strong> para gestão de obras,
              com scripts em <strong class="text-text-primary font-bold">Node.js</strong> para migração do acervo e publicação contínua no <strong class="text-text-primary font-bold">Cloudflare Pages</strong>.
            </p>

            <div class="pt-2 border-t border-border-subtle space-y-3">
              <StaggerContainer stagger={40} class="flex flex-wrap gap-2 text-xs font-mono font-bold">
                <StaggerItem index={0} class="px-2 py-1 bg-bg-panel border border-border-subtle text-text-primary">
                  Astro
                </StaggerItem>
                <StaggerItem index={1} class="px-2 py-1 bg-bg-panel border border-border-subtle text-text-primary">
                  Sanity.io
                </StaggerItem>
                <StaggerItem index={2} class="px-2 py-1 bg-bg-panel border border-border-subtle text-text-primary">
                  Tailwind CSS
                </StaggerItem>
                <StaggerItem index={3} class="px-2 py-1 bg-bg-panel border border-border-subtle text-text-primary">
                  Node.js
                </StaggerItem>
                <StaggerItem index={4} class="px-2 py-1 bg-bg-panel border border-border-subtle text-accent-volt font-bold">
                  Cloudflare Pages
                </StaggerItem>
              </StaggerContainer>

              <div>
                <ArcadeButton
                  href="https://lundgren-atelier.com/"
                  target="_blank"
                  rel="noopener noreferrer"
                  variant="volt"
                  size="md"
                >
                  Visitar lundgren-atelier.com ↗
                </ArcadeButton>
              </div>
            </div>
          </div>

          <div class="lg:col-span-7">
            <ParallaxSection amplitude={10} class="overflow-hidden">
              <figure class="border-2 border-border-subtle hover:border-eva-purple bg-bg-surface shadow-hard-solid overflow-hidden relative transition-colors">
                <div class="px-4 py-2 border-b border-border-subtle bg-bg-panel flex items-center justify-between text-xs font-mono font-bold text-text-secondary uppercase">
                  <div class="flex items-center gap-1.5" aria-hidden="true">
                    <span class="w-2.5 h-2.5 bg-eva-purple inline-block"></span>
                    <span class="w-2.5 h-2.5 bg-eva-purple-light inline-block"></span>
                    <span class="w-2.5 h-2.5 bg-accent-volt inline-block"></span>
                  </div>
                  <span class="text-text-primary text-[11px]">https://lundgren-atelier.com/</span>
                  <span class="text-accent-volt font-bold flex items-center gap-1">
                    <span class="w-2 h-2 rounded-full bg-accent-volt inline-block animate-pulse"></span>
                    <span>ONLINE</span>
                  </span>
                </div>
                <img
                  src="/images/projetos/lundgren-atelier-home.png"
                  alt="Interface inicial do Lundgren Atelier em produção, exibindo obras em layout de galeria e tipografia editorial"
                  width={1440}
                  height={900}
                  loading="eager"
                  decoding="async"
                  class="w-full h-auto block"
                />
              </figure>
            </ParallaxSection>
          </div>
        </article>
      </PerspectiveCard>

      <!-- PROJETO II: BIOACÚSTICA (LÂMINA CIENTÍFICA + CENÁRIOS ACADÊMICOS) -->
      <PerspectiveCard maxTilt={5}>
        <article class="space-y-6">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
            <div class="lg:col-span-6 space-y-4">
              <div class="flex flex-wrap items-center gap-2 text-xs font-mono font-bold uppercase">
                <span class="inline-block px-2.5 py-0.5 bg-accent-alert text-text-on-volt manga-tag-chamfer shadow-hard-solid">
                  NERV ALERT // VII CoBICET (2026)
                </span>
                <span class="text-text-secondary">ISSN 2764-0582</span>
              </div>

              <h3 class="font-display font-black text-2xl sm:text-3xl text-text-primary uppercase tracking-tight leading-tight">
                Detecção Acústica de Aves Ameaçadas com Aprendizado de Máquina
              </h3>

              <p class="text-sm sm:text-base text-text-secondary leading-relaxed font-sans font-medium">
                Pesquisa de iniciação científica e TCC no IF Sudeste MG em coautoria com o Prof. Maurício Archanjo Nunes Coelho. Investigamos a identificação automática de <strong class="text-text-primary font-bold">136 espécies de aves ameaçadas</strong> (repositório <strong class="text-text-primary font-bold">Xeno-Canto</strong>), extraindo <strong class="text-text-primary font-bold">Espectrogramas Mel</strong> e coeficientes <strong class="text-text-primary font-bold">MFCC</strong> para avaliar <strong class="text-text-primary font-bold">SVM (MVS)</strong>, <strong class="text-text-primary font-bold">GMM-HMM (MOM)</strong> e <strong class="text-text-primary font-bold">Redes Neurais Convolucionais (CNN / RNC)</strong>.
              </p>

              <div class="pt-2 flex flex-wrap items-center gap-4">
                <ArcadeButton
                  href={contactLinks.lattesUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  variant="purple"
                  size="md"
                >
                  Registro no Currículo Lattes ↗
                </ArcadeButton>
                <span class="text-xs font-mono text-eva-purple-light font-bold">
                  // CÓDIGO EXPERIMENTAL EM PREPARAÇÃO
                </span>
              </div>
            </div>

            <!-- Palco Científico Mecha: Comparativo Cenário A vs Cenário B -->
            <div class="lg:col-span-6 bg-bg-panel text-text-primary border-2 border-border-subtle p-5 sm:p-6 shadow-hard-solid space-y-4 relative">
              <div class="flex flex-wrap items-center justify-between gap-2 border-b border-border-subtle pb-2 text-xs font-mono font-bold uppercase tracking-wider">
                <span class="text-eva-purple-light">// EXPERIMENTAL_DESIGN · 136 SPECIES</span>
                <span class="text-accent-volt font-bold">XENO-CANTO · MEL & MFCC</span>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="border-2 border-border-subtle bg-bg-surface p-4 space-y-1">
                  <div class="text-[11px] font-mono text-text-secondary uppercase font-bold">01 · LINHA DE BASE</div>
                  <h4 class="font-display font-extrabold text-base text-text-primary uppercase">Cenário A (Controle)</h4>
                  <p class="text-xs font-sans text-text-secondary leading-relaxed font-medium">
                    Configuração inicial de referência para avaliar os classificadores sobre os sinais acústicos sem o refinamento proposto.
                  </p>
                </div>

                <div class="border-2 border-eva-purple bg-bg-surface p-4 space-y-1 shadow-hard-solid">
                  <div class="text-[11px] font-mono text-accent-volt uppercase font-bold">02 · CONFIGURAÇÃO REFINADA</div>
                  <h4 class="font-display font-extrabold text-base text-text-primary uppercase">Cenário B (Proposto)</h4>
                  <p class="text-xs font-sans text-text-secondary leading-relaxed font-medium">
                    Pipeline espectral refinado avaliado com SVM, GMM-HMM e CNN, no qual a <strong class="text-accent-volt font-bold">CNN alcançou F1-weighted de 0,82</strong>.
                  </p>
                </div>
              </div>

              <div class="pt-2 border-t border-border-subtle flex flex-wrap items-center justify-between gap-2 text-xs font-mono font-bold">
                <span class="text-accent-volt">RESULTADO CNN (CENÁRIO B): F1 = 0,82</span>
                <span class="text-text-secondary">VII CoBICET · XVIII EAMC (LNCC)</span>
              </div>
            </div>
          </div>
        </article>
      </PerspectiveCard>

      <!-- PROJETO III: SHAPEMEAPP (ECOSSISTEMA EXTENSÃO MULTI-MÓDULO) -->
      <PerspectiveCard maxTilt={5}>
        <article class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          <div class="lg:col-span-6 space-y-4">
            <div class="flex flex-wrap items-center gap-2 text-xs font-mono font-bold uppercase">
              <span class="inline-block px-2.5 py-0.5 bg-eva-purple text-text-primary manga-tag-chamfer shadow-hard-solid">
                EXTENSÃO UNIVERSITÁRIA · IF SUDESTE MG
              </span>
              <span class="text-text-secondary">2024 — 2026</span>
            </div>

            <h3 class="font-display font-black text-3xl sm:text-4xl text-text-primary uppercase tracking-tight">
              ShapeMeApp
            </h3>

            <p class="text-sm sm:text-base text-text-secondary leading-relaxed font-sans font-medium">
              Ecossistema desenvolvido no projeto de extensão <em class="text-text-primary font-bold">"Emagreça na Musculação no IF Sudeste MG — Campus Rio Pomba"</em>, integrando três aplicações (<strong class="text-text-primary font-bold">Aluno</strong>, <strong class="text-text-primary font-bold">Professor</strong> e <strong class="text-text-primary font-bold">Coordenador</strong>) e versão web com <strong class="text-text-primary font-bold">Expo Router</strong>. Atuei na evolução em <strong class="text-text-primary font-bold">React Native</strong>, modelagem NoSQL no <strong class="text-text-primary font-bold">Firebase</strong>, cálculos de carga de treino (<strong class="text-text-primary font-bold">CIT, Monotonia e Strain</strong>) e testes de usabilidade — apresentado no <strong class="text-text-primary font-bold">VII SIMEPE (2025)</strong>.
            </p>

            <div class="pt-2 flex flex-wrap items-center gap-3">
              <ArcadeButton
                href="https://github.com/Juanzit/ShapeMeApp"
                target="_blank"
                rel="noopener noreferrer"
                variant="purple"
                size="md"
              >
                Monorepo GitHub ↗
              </ArcadeButton>
              <ArcadeButton
                href="https://github.com/Juanzit/SmaAlunoWeb"
                target="_blank"
                rel="noopener noreferrer"
                variant="surface"
                size="md"
              >
                Módulo Web ↗
              </ArcadeButton>
              <ArcadeButton
                href="https://github.com/Juanzit/SMA_Professor"
                target="_blank"
                rel="noopener noreferrer"
                variant="surface"
                size="md"
              >
                Módulo Professor ↗
              </ArcadeButton>
            </div>
          </div>

          <div class="lg:col-span-6 bg-bg-panel border-2 border-border-subtle p-5 space-y-3 shadow-hard-solid">
            <div class="flex items-center justify-between border-b border-border-subtle pb-2 text-xs font-mono font-bold uppercase">
              <span class="text-text-primary">// ARQUITETURA MULTI-MÓDULO</span>
              <span class="text-eva-purple-light">REACT NATIVE · EXPO · FIREBASE</span>
            </div>

            <div class="divide-y border-border-subtle divide-border-subtle">
              <div class="py-2.5 first:pt-0 space-y-1">
                <div class="flex items-center justify-between text-xs font-mono font-bold">
                  <span class="text-eva-purple-light">MÓDULO 01 · ALUNO MOBILE & WEB</span>
                  <span class="text-text-secondary">SMA_Aluno / SmaAlunoWeb</span>
                </div>
                <p class="text-xs font-sans text-text-secondary leading-relaxed font-medium">
                  Fichas de treino, registro de Percepção Subjetiva de Esforço (PSE) e sincronização em nuvem.
                </p>
              </div>

              <div class="py-2.5 space-y-1">
                <div class="flex items-center justify-between text-xs font-mono font-bold">
                  <span class="text-accent-volt">MÓDULO 02 · PROFESSOR & TELEMETRIA</span>
                  <span class="text-text-secondary">SMA_Professor</span>
                </div>
                <p class="text-xs font-sans text-text-secondary leading-relaxed font-medium">
                  Presença, avaliações físicas (dinamometria, sentar e alcançar) e telemetria gráfica em Victory Native.
                </p>
              </div>

              <div class="py-2.5 last:pb-0 space-y-1">
                <div class="flex items-center justify-between text-xs font-mono font-bold">
                  <span class="text-eva-purple-light">MÓDULO 03 · GESTÃO DO PROJETO</span>
                  <span class="text-text-secondary">SMACoordenador</span>
                </div>
                <p class="text-xs font-sans text-text-secondary leading-relaxed font-medium">
                  Supervisão de turmas, docentes e indicadores consolidados de extensão universitária.
                </p>
              </div>
            </div>
          </div>
        </article>
      </PerspectiveCard>

      <!-- PROJETO IV: NÚCLEO SELVAGEM (PALCO MECHA DE GAME DEV) -->
      <MangaPanel
        accent="purple"
        class="bg-bg-panel border-2 border-border-subtle hover:border-eva-purple p-6 sm:p-8 space-y-6"
      >
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-end border-b border-border-subtle pb-6">
          <div class="lg:col-span-8 space-y-2">
            <div class="flex flex-wrap items-center gap-3 text-xs font-mono font-bold uppercase">
              <span class="px-2.5 py-0.5 bg-eva-purple text-text-primary manga-tag-chamfer shadow-hard-solid font-bold">
                GAME DEVELOPMENT // ROGUELITE AUTORAL
              </span>
              <span class="text-accent-volt">ROBLOX STUDIO · LUAU · BLENDER 3D</span>
            </div>

            <h3 class="font-display font-black text-3xl sm:text-5xl text-text-primary uppercase tracking-tight leading-tight">
              Núcleo Selvagem
            </h3>

            <p class="text-sm sm:text-base text-text-secondary leading-relaxed max-w-[44rem] font-medium font-sans">
              Roguelite autoral de criaturas mutantes em desenvolvimento. Combina incursões de exploração procedurais, evolução genética modular e gerenciamento da Base Pessoal 2.0, unindo programação orientada a dados em <strong class="text-text-primary font-bold">Luau</strong> e modelagem 3D autoral no <strong class="text-text-primary font-bold">Blender</strong>.
            </p>
          </div>

          <div class="lg:col-span-4 lg:text-right">
            <ArcadeButton href="#contato" variant="volt" size="lg">
              Conversar Sobre o Jogo ↓
            </ArcadeButton>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="border-2 border-border-subtle bg-bg-surface p-4 space-y-1.5">
            <div class="text-[11px] font-mono text-eva-purple-light font-bold uppercase tracking-widest">
              01 · CICLO DE EXPEDIÇÕES
            </div>
            <h4 class="font-display font-black text-lg text-text-primary uppercase">Incursões Roguelite</h4>
            <p class="text-xs font-sans text-text-secondary leading-relaxed font-medium">
              Expedições de risco e recompensa, coleta de material genético e validação de estado cliente-servidor.
            </p>
          </div>

          <div class="border-2 border-border-subtle bg-bg-surface p-4 space-y-1.5">
            <div class="text-[11px] font-mono text-accent-volt font-bold uppercase tracking-widest">
              02 · CRIATURAS & MUTAÇÕES
            </div>
            <h4 class="font-display font-black text-lg text-text-primary uppercase">Evolução Modular</h4>
            <p class="text-xs font-sans text-text-secondary leading-relaxed font-medium">
              Composição em Luau onde mutações alteram morfologia e atributos de espécimes modelados no Blender.
            </p>
          </div>

          <div class="border-2 border-border-subtle bg-bg-surface p-4 space-y-1.5">
            <div class="text-[11px] font-mono text-eva-purple-light font-bold uppercase tracking-widest">
              03 · PERSISTÊNCIA
            </div>
            <h4 class="font-display font-black text-lg text-text-primary uppercase">Base Pessoal 2.0</h4>
            <p class="text-xs font-sans text-text-secondary leading-relaxed font-medium">
              Gerenciamento e progressão persistente da base do jogador entre sessões no Roblox Studio.
            </p>
          </div>
        </div>
      </MangaPanel>
    </SectionTransition>

    <!-- FITA DECORATIVA MARQUEE ENTRE SEÇÕES -->
    <GraphicMarquee variant="dark" />

    <!-- 3. OUTROS PROJETOS & COLABORAÇÕES (#github) -->
    <SectionTransition id="github" aria-labelledby="github-title" class="space-y-10 scroll-mt-24">
      <KineticHeading
        index="02"
        tag="// CO-OP_MISSIONS & ALGORITHMS"
        title="Trabalho Colaborativo, Jogos & Ensino"
        titleId="github-title"
        accent="purple"
      >
        <div slot="action">
          <ArcadeButton
            href={contactLinks.githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            variant="surface"
            size="md"
          >
            {contactLinks.githubLabel} ↗
          </ArcadeButton>
        </div>
      </KineticHeading>

      <!-- VITRINE LADO A LADO: ARCHFLOW (COAUTORIA VICTOR EMANUEL) + BLADE OF ALBAIA -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <!-- Coluna 1 (7 cols): ArchFlow -->
        <MangaPanel accent="subtle" class="lg:col-span-7 space-y-4">
          <div class="flex flex-wrap items-center justify-between gap-2 text-xs font-mono font-bold uppercase">
            <span class="px-2.5 py-0.5 bg-eva-purple text-text-primary manga-tag-chamfer shadow-hard-solid">
              CO-OP MISSION // ENGENHARIA DE SOFTWARE
            </span>
            <span class="text-text-secondary">JAVA 17 · JPA · JAVAFX 3D</span>
          </div>

          <h3 class="font-display font-black text-2xl text-text-primary uppercase tracking-tight">
            {archFlowProject.title}
          </h3>

          <figure class="border-2 border-border-subtle bg-bg-surface p-2 space-y-2 shadow-hard-solid">
            <img
              src={archFlowProject.screenshots.main.src}
              alt={archFlowProject.screenshots.main.alt}
              width={archFlowProject.screenshots.main.width}
              height={archFlowProject.screenshots.main.height}
              loading="lazy"
              decoding="async"
              class="w-full h-auto block border border-border-subtle"
            />
            <figcaption class="px-1 text-xs font-mono font-bold text-accent-volt uppercase">
              {archFlowProject.coauthorshipNote}
            </figcaption>
          </figure>

          <p class="text-sm text-text-secondary leading-relaxed font-sans font-medium">
            {archFlowProject.partnerContributions} Atuei na refatoração da arquitetura MVC, controle de acesso, validação de regras de negócio e documentação UML.
          </p>

          <div class="pt-2 border-t border-border-subtle flex flex-wrap items-center justify-between gap-4">
            <ArcadeButton
              href={archFlowProject.repoUrl}
              target="_blank"
              rel="noopener noreferrer"
              variant="purple"
              size="md"
            >
              Repositório no GitHub ↗
            </ArcadeButton>
            <span class="text-xs font-mono text-text-secondary">
              Stack: {archFlowProject.stack}
            </span>
          </div>
        </MangaPanel>

        <!-- Coluna 2 (5 cols): Blade of Albaia -->
        <MangaPanel accent="subtle" class="lg:col-span-5 space-y-4">
          <div class="flex flex-wrap items-center justify-between gap-2 text-xs font-mono font-bold uppercase">
            <span class="px-2.5 py-0.5 bg-bg-panel border border-border-subtle text-accent-volt manga-tag-chamfer">
              GAME DEV // PLATAFORMA 2D
            </span>
            <span class="text-text-secondary">PYTHON · POO</span>
          </div>

          <h3 class="font-display font-black text-2xl text-text-primary uppercase tracking-tight">
            {bladeOfAlbaiaProject.title}
          </h3>

          <figure class="border-2 border-border-subtle bg-bg-surface p-2 space-y-2 shadow-hard-solid">
            <img
              src={bladeOfAlbaiaProject.images.screenshot.src}
              alt={bladeOfAlbaiaProject.images.screenshot.alt}
              width={bladeOfAlbaiaProject.images.screenshot.width}
              height={bladeOfAlbaiaProject.images.screenshot.height}
              loading="lazy"
              decoding="async"
              class="w-full h-auto block border border-border-subtle"
            />
            <figcaption class="px-1 text-xs font-mono font-bold text-text-secondary">
              Jogo autoral de plataforma 2D com física vetorial e combate.
            </figcaption>
          </figure>

          <p class="text-sm text-text-secondary leading-relaxed font-sans font-medium">
            {bladeOfAlbaiaProject.summary}
          </p>

          <div class="pt-2 border-t border-border-subtle flex flex-wrap items-center justify-between gap-4">
            <ArcadeButton
              href={bladeOfAlbaiaProject.repoUrl}
              target="_blank"
              rel="noopener noreferrer"
              variant="surface"

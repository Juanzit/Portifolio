---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Badge from '../components/ui/Badge.astro';

const projects = [
  {
    code: 'PRJ-01',
    category: 'PROJETO FREELANCE // ENGENHARIA WEB',
    status: 'EM PRODUÇÃO',
    statusVariant: 'success' as const,
    title: 'Lundgren Atelier — Plataforma Digital em Produção',
    summary:
      'Desenvolvimento completo e publicação de website comercial em produção, integrando Astro, Sanity.io (Headless CMS), estilização com Tailwind CSS, scripts automatizados em Node.js para migração de acervo e deploy contínuo via Cloudflare Pages.',
    metrics: 'Em Produção • Astro + Sanity.io + Cloudflare Pages',
    stack: ['Astro', 'Sanity.io (Headless CMS)', 'Tailwind CSS', 'Node.js (Scripts de Migração)', 'Cloudflare Pages'],
    links: [{ label: 'Acessar Site Oficial ↗', href: 'https://lundgren-atelier.com/', external: true }],
  },
  {
    code: 'PRJ-02',
    category: 'PESQUISA CIENTÍFICA // BIOACÚSTICA & IA',
    status: 'PUBLICADO (VII CoBICET)',
    statusVariant: 'accent' as const,
    title: 'Detecção Acústica de Aves Ameaçadas Utilizando Aprendizado de Máquina',
    summary:
      'Trabalho Completo publicado nos Anais do VII CoBICET (05/08/2026, Editora Even3) e apresentado no XVIII EAMC (2026), em coautoria com Maurício Archanjo Nunes Coelho. Investigação sobre 136 espécies ameaçadas (Xeno-Canto) com Espectrogramas Mel e MFCC, comparando SVM (MVS), GMM-HMM (MOM) e CNN (RNC) entre o Cenário A (Controle) e o Cenário B (Proposto).',
    metrics: 'CNN F1-weighted: 0,82 (~82% Acurácia) • ISSN 2764-0582',
    stack: ['Python', 'CNN (RNC)', 'SVM (MVS)', 'GMM-HMM (MOM)', 'Espectrogramas Mel & MFCC', 'Xeno-Canto (136 espécies)'],
    links: [{ label: 'Ver Registro no Lattes ↗', href: 'http://lattes.cnpq.br/9434044887106048', external: true }],
  },
  {
    code: 'PRJ-03',
    category: 'PROJETO ACADÊMICO // EXTENSÃO & MOBILE',
    status: 'CONCLUÍDO (2024–2026)',
    statusVariant: 'accent' as const,
    title: 'ShapeMeApp — Monitoramento de Carga e Evolução na Musculação',
    summary:
      'Aplicativo mobile Android desenvolvido no ciclo de extensão 2024–2026 (IF Sudeste MG — Campus Rio Pomba) para alunos, professores e coordenação, com cálculo de Carga Interna de Treinamento (CIT), Monotonia e Strain. Estudo apresentado no VII SIMEPE (2025) em coautoria com Gustavo Vaz Teixeira, Sérgio Muinhos Barroso Lima e João Batista Ferreira Júnior.',
    metrics: 'Apresentado no VII SIMEPE (2025) • CIT, Monotonia & Strain',
    stack: ['React Native', 'Expo SDK', 'Firebase Auth', 'Cloud Firestore', 'AsyncStorage', 'QA & Usabilidade'],
    links: [{ label: 'Referência Acadêmica ↗', href: 'http://lattes.cnpq.br/9434044887106048', external: true }],
  },
  {
    code: 'PRJ-04',
    category: 'PROJETO AUTORAL // GAME DEVELOPMENT LAB',
    status: 'EM DESENVOLVIMENTO',
    statusVariant: 'neutral' as const,
    title: 'Núcleo Selvagem — Roguelite de Criaturas Mutantes',
    summary:
      'Projeto autoral de jogo roguelite com sistema de expedições, evolução genética de criaturas mutantes e Base Pessoal 2.0, desenvolvido com arquitetura modular em Luau no Roblox Studio e modelagem 3D autoral no Blender.',
    metrics: 'Expedições, Evolução Genética & Base Pessoal 2.0',
    stack: ['Roblox Studio', 'Luau', 'Blender (Modelagem 3D)', 'Arquitetura Modular', 'Sistemas Roguelite'],
    links: [{ label: 'Inspecionar no Game Lab ↓', href: '#game-lab', external: false }],
  },
];

const experiences = [
  {
    period: '04/2026 — ATUAL',
    role: 'Professor Tutor',
    org: 'CNA Digital',
    tag: 'ENSINO DE PROGRAMAÇÃO, 3D, JOGOS & IA (15H/SEM)',
    description:
      'Atuação como professor de programação conduzindo trilhas técnicas de lógica, Scratch, Construct, modelagem 3D com Blender e SculptGL, Unity, Roblox Studio, React, Python, Ciência de Dados e Inteligência Artificial.',
  },
  {
    period: '06/2025 — ATUAL',
    role: 'Professor Tutor',
    org: 'Kodland',
    tag: 'EDTECH INTERNACIONAL • PYTHON, LUA & SCRATCH (12H/SEM)',
    description:
      'Ensino de programação para alunos de 8 a 16 anos em Scratch, Python (incluindo Flask, POO e bancos de dados) e Roblox Studio/Lua, aplicando metodologia PBL (Project-Based Learning), Scrum e versionamento com Git/GitHub.',
  },
  {
    period: '06/2025 — 06/2026',
    role: 'Pesquisador em Inteligência Artificial',
    org: 'IF Sudeste MG — Campus Rio Pomba',
    tag: 'PESQUISA CIENTÍFICA PUBLICADA (VII CoBICET & XVIII EAMC)',
    description:
      'Desenvolvimento de sistema e modelos de aprendizado de máquina para identificação automática de 136 espécies de aves ameaçadas de extinção, comparando RNC/CNN, MVS/SVM e MOM/HMM entre o Cenário A (Controle) e o Cenário B (Proposto).',
  },
  {
    period: '09/2025 — 01/2026',
    role: 'Desenvolvedor Java',
    org: 'IF Sudeste MG — Campus Rio Pomba',
    tag: 'ENGENHARIA DE SOFTWARE & PERSISTÊNCIA RELACIONAL',
    description:
      'Engenharia de software com levantamento de requisitos, modelagem em diagramas UML, Programação Orientada a Objetos em Java, persistência com JPA/PostgreSQL e autenticação segura com BCrypt.',
  },
  {
    period: '08/2024 — 01/2026',
    role: 'Desenvolvedor Mobile Júnior — Projeto ShapeMeApp',
    org: 'IF Sudeste MG — Campus Rio Pomba',
    tag: 'EXTENSÃO TECNOLÓGICA • REACT NATIVE & FIREBASE',
    description:
      'Atuação no projeto de extensão "Emagreça na Musculação no IF Sudeste MG - Campus Rio Pomba" (ShapeMeApp), realizando QA, testes de usabilidade, evolução mobile em React Native/Expo, modelagem NoSQL no Firebase e gestão ágil com Jira e GitHub.',
  },
  {
    period: '06/2022 — 11/2025',
    role: 'Membro de Projetos / Validação e Prototipação',
    org: 'EmComp — Empresa Júnior de Computação (IF Sudeste MG)',
    tag: 'EMPRESA JÚNIOR • 100 HORAS CERTIFICADAS',
    description:
      'Atuação no desenvolvimento do site da Labclin, prototipação de sites e aplicativos, validação de UX/UI e organização de eventos técnicos junto ao Núcleo da Mata.',
  },
];

const complementaryActivities = [
  {
    period: '03/2025 — 08/2025',
    title: 'Monitor Voluntário de Linguagens Formais e Autômatos',
    detail: 'IF Sudeste MG — Apoio acadêmico em autômatos, gramáticas e teoria da computação.',
  },
  {
    period: '2025',
    title: 'Ministrante de Minicurso Presencial: React com Firebase',
    detail: 'IF Sudeste MG — Capacitação prática em interfaces reativas e integração em nuvem.',
  },
  {
    period: '12/2023 — 08/2024',
    title: 'Instrutor de Desenvolvimento Mobile (JavaScript & React Native)',
    detail: 'IF Sudeste MG — Produção e gravação de 16 videoaulas técnicas sobre desenvolvimento mobile.',
  },
  {
    period: '2020',
    title: 'Voluntário no Curso "Python Básico pra Quem Tem Pressa"',
    detail: 'IF Sudeste MG — Apoio na introdução prática à lógica e programação em Python.',
  },
];

const journalPreviews = [
  {
    code: 'CADERNO-01',
    category: 'PESQUISA EM IA & SINAIS',
    title: 'Espectrogramas Mel e MFCC na Classificação de 136 Espécies Ameaçadas: Cenário A vs. Cenário B',
    excerpt:
      'Análise técnica comparando SVM (MVS), GMM-HMM (MOM) e CNN (RNC) sobre áudios do Xeno-Canto entre o Cenário A (Controle) e o Cenário B (Proposto), no qual a CNN atingiu F1-weighted de 0,82 (~82% de acurácia).',
    meta: 'Publicado nos Anais do VII CoBICET (ISSN 2764-0582) e XVIII EAMC (2026)',
  },
  {
    code: 'CADERNO-02',
    category: 'ENGENHARIA MOBILE & EXTENSÃO',
    title: 'Evolução de Software em Ambientes Acadêmicos: ShapeMeApp, CIT, Monotonia e Strain',
    excerpt:
      'Arquitetura em React Native, Expo SDK, Firebase Auth, Cloud Firestore e AsyncStorage para acompanhamento de alunos, professores e coordenação a partir de feedbacks reais de usabilidade.',
    meta: 'Apresentado no VII SIMEPE (2025) — IF Sudeste MG',
  },
  {
    code: 'CADERNO-03',
    category: 'ENGENHARIA WEB & GAME SYSTEMS',
    title: 'Migração Headless com Astro + Sanity.io e Sistemas Roguelite em Luau/Blender',
    excerpt:
      'Decisões práticas de engenharia na entrega comercial do Lundgren Atelier em Cloudflare Pages e na arquitetura de expedições, evolução genética e Base Pessoal 2.0 do Núcleo Selvagem.',
    meta: 'Notas de Arquitetura — Produção Web & Game Dev Lab',
  },
];

const skillGroups = [
  {
    title: 'Linguagens & Backend',
    code: 'GRP-01',
    items: [
      'Python (Flask / POO / Dados)',
      'TypeScript & JavaScript',
      'Java (POO / JPA / BCrypt)',
      'Luau / Lua (Roblox Studio)',
      'SQL & PostgreSQL',
      'Modelagem UML & Requisitos',
    ],
  },
  {
    title: 'Engenharia Web & Mobile',
    code: 'GRP-02',
    items: [
      'React Native & Expo SDK',
      'React',
      'Astro & Tailwind CSS',
      'Sanity.io (Headless CMS)',
      'Node.js',
      'Firebase (Auth / Firestore) & AsyncStorage',
      'Cloudflare Pages',
    ],
  },
  {
    title: 'IA, Ciência de Dados & Bioacústica',
    code: 'GRP-03',
    items: [
      'Redes Neurais Convolucionais (CNN / RNC)',
      'Máquinas de Vetores de Suporte (SVM / MVS)',
      'Modelos Ocultos de Markov (GMM-HMM / MOM)',
      'Espectrogramas Mel & MFCC',
      'Base Xeno-Canto (136 espécies)',
      'Ciência de Dados & IA',
    ],
  },
  {
    title: 'Game Dev, 3D & Metodologias',
    code: 'GRP-04',
    items: [
      'Roblox Studio & Unity',
      'Blender & SculptGL (Modelagem 3D)',
      'Scratch & Construct',
      'Git, GitHub & Jira',
      'Scrum, QA & Testes de Usabilidade',
      'Metodologia PBL (Ensino de Tecnologia)',
    ],
  },
];
---

<BaseLayout
  title="Juan Silva Garcia — Engenharia de Software, Pesquisa em IA & Sistemas Interativos"
  description="Portfólio profissional e acadêmico de Juan Silva Garcia (GARCIA, J. S.). Graduando em Ciência da Computação e Técnico em Informática (IF Sudeste MG), desenvolvedor Web/Mobile/Java, pesquisador publicado em IA aplicada à bioacústica (VII CoBICET, ISSN 2764-0582) e Professor Tutor na CNA Digital e Kodland."
>
  <Header />

  <main id="main-content" tabindex="-1" class="max-w-[1120px] mx-auto px-4 sm:px-8">
    <!-- 1. HERO SECTION -->
    <section aria-labelledby="hero-heading" class="py-12 sm:py-20 border-b border-border-subtle">
      <div class="flex flex-wrap items-center gap-2.5 mb-6">
        <Badge variant="success">DISPONÍVEL PARA PROJETOS & P&D</Badge>
        <Badge variant="accent">CIÊNCIA DA COMPUTAÇÃO — IF SUDESTE MG</Badge>
        <Badge variant="neutral">RIO POMBA, MG — BRASIL</Badge>
      </div>

      <h1
        id="hero-heading"
        class="text-3xl sm:text-5xl font-bold tracking-[-0.025em] text-text-primary leading-[1.12] max-w-[22ch]"
      >
        Engenharia de Software, Pesquisa em IA e Sistemas Interativos.
      </h1>

      <p class="mt-6 text-base sm:text-lg text-text-secondary leading-[1.65] max-w-[65ch]">
        Sou <strong class="text-text-primary font-semibold">Juan Silva Garcia</strong> (<code class="text-[13px] font-mono text-accent-text">GARCIA, J. S.</code>),
        graduando em Ciência da Computação e Técnico em Informática pelo IF Sudeste MG — Campus Rio Pomba. Desenvolvo
        sistemas web, mobile e Java, pesquiso aprendizado de máquina aplicado à bioacústica de espécies ameaçadas e
        atuo como Professor Tutor de programação, jogos e IA na CNA Digital e na Kodland.
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-3.5">
        <a
          href="#projetos"
          class="min-h-[44px] px-6 py-2.5 inline-flex items-center justify-center bg-accent-solid hover:bg-accent-solid-hover text-white font-medium text-sm transition-colors"
        >
          Explorar Projetos Selecionados
        </a>
        <a
          href="#experiencia"
          class="min-h-[44px] px-6 py-2.5 inline-flex items-center justify-center bg-bg-surface hover:bg-bg-elevated text-text-primary border border-border-control hover:border-accent-text font-medium text-sm transition-colors"
        >
          Trajetória & Experiência
        </a>
        <a
          href="#contato"
          class="min-h-[44px] px-4 py-2.5 inline-flex items-center justify-center font-mono text-[13px] leading-normal text-accent-text hover:underline"
        >
          Contato Direto →
        </a>
      </div>

      <!-- Painel Técnico de Credenciais Rápidas -->
      <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="border border-border-subtle bg-bg-surface p-5 space-y-1.5">
          <div class="flex items-center justify-between font-mono text-[13px] leading-normal text-text-secondary">
            <span>PUBLICAÇÃO CIENTÍFICA</span>
            <span class="text-metric-accent">05/08/2026</span>
          </div>
          <p class="text-base font-semibold text-text-primary">Anais VII CoBICET (ISSN 2764-0582)</p>
          <p class="text-[13px] text-text-secondary leading-normal">
            Classificação acústica de 136 espécies de aves ameaçadas: CNN com F1-weighted de 0,82 (~82% de acurácia) no
            Cenário B (Proposto).
          </p>
        </div>

        <div class="border border-border-subtle bg-bg-surface p-5 space-y-1.5">
          <div class="flex items-center justify-between font-mono text-[13px] leading-normal text-text-secondary">
            <span>ENGENHARIA WEB, MOBILE & JAVA</span>
            <span class="text-metric-accent">PRODUÇÃO</span>
          </div>
          <p class="text-base font-semibold text-text-primary">Lundgren Atelier & ShapeMeApp</p>
          <p class="text-[13px] text-text-secondary leading-normal">
            Website comercial em Astro + Sanity.io + Cloudflare Pages e app Android em React Native + Expo + Firebase
            (VII SIMEPE 2025).
          </p>
        </div>

        <div class="border border-border-subtle bg-bg-surface p-5 space-y-1.5">
          <div class="flex items-center justify-between font-mono text-[13px] leading-normal text-text-secondary">
            <span>DOCÊNCIA TECNOLÓGICA</span>
            <span class="text-metric-accent">ATIVO</span>
          </div>
          <p class="text-base font-semibold text-text-primary">Professor Tutor (CNA Digital & Kodland)</p>
          <p class="text-[13px] text-text-secondary leading-normal">
            Ensino prático de Python (Flask/POO), React, Roblox Studio/Luau, Unity, modelagem 3D no Blender e IA.
          </p>
        </div>
      </div>
    </section>

    <!-- 2. APRESENTAÇÃO / PERFIL DE ENGENHARIA -->
    <section id="apresentacao" aria-labelledby="apresentacao-heading" class="py-16 border-b border-border-subtle">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <div class="lg:col-span-5 space-y-3">
          <span class="font-mono text-[13px] leading-normal uppercase tracking-wider text-accent-text block">
            00. Perfil Técnico & Abordagem de Engenharia
          </span>
          <h2 id="apresentacao-heading" class="text-2xl font-semibold tracking-[-0.015em] text-text-primary">
            Rigor científico aliado à entrega de software funcional.
          </h2>
          <p class="text-sm text-text-secondary leading-relaxed">
            Minha trajetória no IF Sudeste MG — Campus Rio Pomba integra formação técnica em Informática, graduação em
            Ciência da Computação, pesquisa experimental publicada em Inteligência Artificial e entrega de sistemas
            web, mobile, Java e jogos autorais.
          </p>
        </div>

        <div class="lg:col-span-7 border border-border-subtle bg-bg-surface p-6 space-y-4">
          <div class="flex items-center justify-between border-b border-border-subtle pb-3 font-mono text-[13px] leading-normal">
            <span class="text-accent-text">FORMAÇÃO & CREDENCIAIS COMPROVADAS (GARCIA, J. S.)</span>
            <span class="text-metric-accent">VERIFICADO</span>
          </div>

          <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
            <div class="space-y-1">
              <dt class="font-mono text-[13px] leading-normal text-text-secondary">GRADUAÇÃO EM ANDAMENTO</dt>
              <dd class="font-medium text-text-primary">Bacharelado em Ciência da Computação (2022–2026)</dd>
              <dd class="text-[13px] leading-normal text-text-secondary">IF Sudeste MG — Campus Rio Pomba</dd>
            </div>

            <div class="space-y-1">
              <dt class="font-mono text-[13px] leading-normal text-text-secondary">FORMAÇÃO TÉCNICA</dt>
              <dd class="font-medium text-text-primary">Técnico em Informática (2019–2021 / Lattes 2019–2022)</dd>
              <dd class="text-[13px] leading-normal text-text-secondary">
                IF Sudeste MG — Campus Rio Pomba
              </dd>
            </div>

            <div class="space-y-1">
              <dt class="font-mono text-[13px] leading-normal text-text-secondary">PUBLICAÇÕES & EVENTOS</dt>
              <dd class="font-medium text-text-primary">VII CoBICET (2026), XVIII EAMC (2026) & VII SIMEPE (2025)</dd>
              <dd class="text-[13px] leading-normal text-text-secondary">
                Coautoria com Maurício A. N. Coelho (Bioacústica) e equipe ShapeMeApp
              </dd>
            </div>

            <div class="space-y-1">
              <dt class="font-mono text-[13px] leading-normal text-text-secondary">REGISTRO BIBLIOGRÁFICO</dt>
              <dd class="font-medium text-text-primary">Trabalho Completo — Editora Even3 (05/08/2026)</dd>
              <dd class="text-[13px] leading-normal font-mono text-metric-accent">ISSN: 2764-0582 • Lattes CNPq</dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    <!-- 3. VITRINE DE PROJETOS (4 PILARES) -->
    <section id="projetos" aria-labelledby="projetos-heading" class="py-16 border-b border-border-subtle space-y-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <div class="space-y-2">
          <span class="font-mono text-[13px] leading-normal uppercase tracking-wider text-accent-text block">
            01. Projetos Selecionados & Pesquisa Aplicada
          </span>
          <h2 id="projetos-heading" class="text-2xl sm:text-3xl font-semibold tracking-[-0.015em] text-text-primary">
            Sistemas em Produção, Mobile, IA e Jogos Autorais
          </h2>
        </div>
        <p class="font-mono text-[13px] leading-normal text-text-secondary">
          4 PROJETOS PRINCIPAIS • DADOS AUDITADOS
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {
          projects.map((project) => (
            <article class="border border-border-subtle bg-bg-surface hover:border-accent-primary transition-colors p-6 flex flex-col justify-between space-y-6">
              <div class="space-y-4">
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <span class="font-mono text-[13px] leading-normal text-accent-text">
                    {project.code} // {project.category}
                  </span>
                  <Badge variant={project.statusVariant}>{project.status}</Badge>
                </div>

                <h3 class="text-xl font-semibold text-text-primary leading-snug">{project.title}</h3>

                <p class="text-sm text-text-secondary leading-relaxed">{project.summary}</p>
              </div>

              <div class="space-y-4 pt-4 border-t border-border-subtle">
                <div class="flex items-center justify-between font-mono text-[13px] leading-normal">
                  <span class="text-text-secondary">INDICADOR TÉCNICO</span>
                  <span class="text-metric-accent font-medium">{project.metrics}</span>
                </div>

                <div class="flex flex-wrap gap-1.5">
                  {project.stack.map((tech) => (
                    <span class="px-2 py-0.5 bg-bg-canvas border border-border-subtle font-mono text-[13px] leading-normal text-text-secondary">
                      {tech}
                    </span>
                  ))}
                </div>

                <div class="pt-1 flex flex-wrap items-center gap-4">
                  {project.links.map((link) => (
                    <a
                      href={link.href}
                      target={link.external ? '_blank' : undefined}
                      rel={link.external ? 'noopener noreferrer' : undefined}
                      class="min-h-[44px] inline-flex items-center text-sm font-mono text-accent-text hover:underline"
                    >
                      {link.label}
                    </a>
                  ))}
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- 4. GAME DEVELOPMENT LAB (SEÇÃO DEDICADA — NÚCLEO SELVAGEM) -->
    <section id="game-lab" aria-labelledby="gamelab-heading" class="py-16 border-b border-border-subtle space-y-8">
      <div class="space-y-2">
        <span class="font-mono text-[13px] leading-normal uppercase tracking-wider text-accent-text block">
          02. Game Development Lab — Núcleo Selvagem
        </span>
        <h2 id="gamelab-heading" class="text-2xl sm:text-3xl font-semibold tracking-[-0.015em] text-text-primary">
          Roguelite Autoral em Luau, Roblox Studio e Modelagem 3D no Blender
        </h2>
        <p class="text-sm sm:text-base text-text-secondary max-w-[65ch] leading-relaxed">
          Apresentado exclusivamente como projeto autoral deste laboratório, <strong class="text-text-primary">Núcleo Selvagem</strong> é um
          roguelite de criaturas mutantes em desenvolvimento, combinando expedições procedurais, evolução genética e
          sistema de Base Pessoal 2.0 com programação modular em Luau (Roblox Studio) e assets 3D modelados no Blender.
        </p>
      </div>

      <div class="border border-border-subtle bg-bg-surface">
        <div class="px-5 py-3.5 border-b border-border-subtle bg-bg-elevated flex flex-wrap items-center justify-between gap-4">
          <div class="flex items-center gap-3">
            <span class="w-2.5 h-2.5 rounded-full bg-metric-accent" aria-hidden="true"></span>
            <span class="font-mono text-[13px] leading-normal font-medium text-text-primary">
              ARQUITETURA DE SISTEMAS — NÚCLEO SELVAGEM (ROBLOX STUDIO / LUAU / BLENDER)
            </span>
          </div>
          <span class="font-mono text-[13px] leading-normal text-accent-text">EM DESENVOLVIMENTO</span>
        </div>

        <div class="p-6 grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="border border-border-subtle bg-bg-canvas p-5 space-y-2">
            <div class="font-mono text-[13px] leading-normal text-accent-text">SYS-01 // EXPEDIÇÕES ROGUELITE</div>

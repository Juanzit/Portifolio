        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
          {
            publications.map((pub) => (
              <article class="border border-border-subtle bg-bg-surface p-5 flex flex-col justify-between space-y-3">
                <div class="space-y-2">
                  <div class="font-mono text-[13px] leading-normal text-metric-accent">
                    {pub.year} · {pub.type}
                  </div>
                  <h4 class="text-base font-semibold text-text-primary leading-snug">{pub.title}</h4>

                Lattes ↗
              </a>
            </div>

            <div class="font-mono text-xs text-text-primary font-bold">
              Artigo nos Anais · VII CoBICET (2026 · ISSN 2764-0582)
            </div>
            <p class="font-display font-black text-base text-text-primary uppercase leading-snug">
              Detecção Acústica de Aves Ameaçadas Utilizando Aprendizado de Máquina
            </p>
            <p class="text-xs text-text-secondary font-mono">
              GARCIA, J. S.; COELHO, M. A. N. · Editora Even3 · Apresentado no <strong>XVIII EAMC / LNCC (2026)</strong>.
            </p>
          </div>
        </div>

        <!-- Coluna Direita: Timeline estilo Questline com Marcadores que Acendem -->
        <div slot="content" class="space-y-4 pl-0 lg:pl-4">
          <div class="flex items-baseline justify-between gap-2 pb-2 border-b border-border-subtle text-xs font-mono font-bold uppercase">
            <span class="text-eva-purple-light">// EXPERIÊNCIAS SELECIONADAS (QUESTLINE)</span>
            <span class="text-text-secondary">2024 — ATUAL</span>
          </div>

          <div class="relative pl-6 sm:pl-8 space-y-4">
            <!-- Linha vertical de progresso cinemático -->
            <div aria-hidden="true" class="absolute left-2.5 top-2 bottom-2 w-1 bg-border-subtle">
              <div class="story-timeline-fill w-full h-full bg-accent-volt"></div>
            </div>

            {
              featuredExperiences.map((exp) => (
                <div
                  data-story-step
                  class="relative p-4 sm:p-5 border-2 border-border-subtle hover:border-eva-purple bg-bg-surface hover:bg-bg-panel-raised transition-all shadow-hard-solid space-y-1.5"
                >
                  <span
                    data-step-dot
                    aria-hidden="true"
                    class="absolute -left-[1.85rem] sm:-left-[2.35rem] top-5 w-3.5 h-3.5 bg-bg-canvas border-2 border-border-subtle"
                  />

                  <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
                    <h4 class="font-display font-black text-lg text-text-primary uppercase tracking-tight">{exp.role}</h4>
                    <span class="font-mono text-xs text-accent-volt font-bold">
                      {exp.org} // {exp.period}
                    </span>
                  </div>
                  <p class="text-xs sm:text-sm text-text-secondary leading-relaxed font-sans font-medium">{exp.shortSummary}</p>
                </div>
              ))
            }
          </div>
        </div>
      </StickyStorySection>
    </SectionTransition>

    <!-- 5. TERMINAL DE CONTATO DIRETO (#contato) -->

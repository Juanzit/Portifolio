---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import {
  heroTechLine,
  archFlowProject,
  bladeOfAlbaiaProject,
  compactOtherProjects,
  experiences,
  education,
  scientificOutputs,
  contactLinks,
} from '../data/portfolio';
---

<BaseLayout
  title="Juan Silva Garcia — Caderno de Projetos, Pesquisa & Software"
  description="Portfólio pessoal e acadêmico de Juan Silva Garcia (GARCIA, J. S.). Estudante de Ciência da Computação e Técnico em Informática no IF Sudeste MG (Campus Rio Pomba), explorando aplicações mobile e web, pesquisa em bioacústica com aprendizado de máquina, jogos e ensino de programação."
>
  <Header />

  <main id="main-content" tabindex="-1" class="max-w-[1120px] mx-auto px-4 sm:px-8">
    <!-- 1. HERO EDITORIAL (APRESENTAÇÃO E TECNOLOGIAS PRINCIPAIS) -->
    <section aria-labelledby="hero-heading" class="py-12 sm:py-20 border-b border-border-subtle">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-end">
        <div class="lg:col-span-8 space-y-5">
          <p class="text-[13px] leading-normal font-mono text-accent-text tracking-wide">
            Cataguases, MG · IF Sudeste MG — Campus Rio Pomba
          </p>

          <h1
            id="hero-heading"
            class="font-display text-4xl sm:text-6xl font-medium tracking-[-0.02em] text-text-primary leading-[1.08]"
          >
            Olá, eu sou o Juan.
          </h1>

          <p class="font-display italic text-2xl sm:text-3xl text-text-primary/90 leading-[1.32] max-w-[34ch]">
            Entre aplicativos, pesquisa, jogos e ensino, venho explorando diferentes possibilidades da computação.
          </p>

          <p class="text-base sm:text-lg text-text-secondary leading-[1.68] max-w-[60ch]">
            Estudo Ciência da Computação no IF Sudeste MG. Neste portfólio, reúno projetos que desenvolvi e trabalhos
            em que colaborei, mostrando os problemas, as soluções e o que aprendi em cada experiência.
          </p>

          <p
            aria-label="Tecnologias principais"
            class="pt-1 font-mono text-[13px] leading-normal text-metric-accent font-medium tracking-wide"
          >
            {heroTechLine}
          </p>

          <div class="pt-2 flex flex-wrap items-center gap-3.5">
            <a
              href="#projetos"
              class="min-h-[44px] px-6 py-2.5 inline-flex items-center justify-center bg-accent-solid hover:bg-accent-solid-hover text-white font-medium text-sm transition-colors"
            >
              Conhecer os projetos
            </a>
            <a
              href="#github"
              class="min-h-[44px] px-6 py-2.5 inline-flex items-center justify-center bg-bg-surface hover:bg-bg-elevated text-text-primary border border-border-control hover:border-accent-solid font-medium text-sm transition-colors"
            >
              Outros projetos & GitHub
            </a>
            <a
              href="#contato"
              class="min-h-[44px] px-4 py-2.5 inline-flex items-center justify-center text-sm font-medium text-accent-text hover:underline"
            >
              Entrar em contato →
            </a>
          </div>
        </div>

        <!-- Coluna de Margem (Nota de Caderno de Campo) -->
        <aside aria-label="Síntese de formação e atuação" class="lg:col-span-4 border-l-2 border-accent-solid pl-6 space-y-4">
          <div class="space-y-1">
            <div class="text-[13px] leading-normal font-mono text-text-secondary">Formação no IF Sudeste MG</div>
            <p class="font-display text-lg font-medium text-text-primary leading-snug">
              Bacharelado em Ciência da Computação & Técnico em Informática
            </p>
          </div>

          <div class="space-y-1">
            <div class="text-[13px] leading-normal font-mono text-text-secondary">Frentes de Trabalho</div>
            <p class="text-sm text-text-secondary leading-relaxed">
              Aplicações mobile e web, pesquisa científica em bioacústica com aprendizado de máquina, desenvolvimento de
              jogos e docência em programação na <strong class="text-text-primary font-medium">CNA Digital</strong> e na <strong class="text-text-primary font-medium">Kodland</strong>.
            </p>
          </div>

          <div class="pt-0.5 flex flex-wrap items-center gap-4">
            <a
              href={contactLinks.linkedinUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="min-h-[44px] inline-flex items-center text-[13px] leading-normal font-mono text-accent-text hover:underline"
            >
              LinkedIn ↗
            </a>
            <a
              href={contactLinks.lattesUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="min-h-[44px] inline-flex items-center text-[13px] leading-normal font-mono text-metric-accent hover:underline"
            >
              Currículo Lattes (CNPq) ↗
            </a>
          </div>
        </aside>
      </div>
    </section>

    <!-- 2. QUATRO PROJETOS PRINCIPAIS (CADA UM COM COMPOSIÇÃO PRÓPRIA) -->
    <section id="projetos" aria-labelledby="projetos-heading" class="py-12 sm:py-16 border-b border-border-subtle space-y-14">
      <div class="max-w-[64ch] space-y-2.5">
        <p class="text-[13px] leading-normal font-mono text-accent-text">Trabalhos Principais</p>
        <h2
          id="projetos-heading"
          class="font-display text-3xl sm:text-4xl font-medium tracking-[-0.015em] text-text-primary leading-tight"
        >
          Quatro projetos, quatro problemas diferentes
        </h2>
        <p class="text-base text-text-secondary leading-relaxed">
          De uma plataforma comercial em produção e um ecossistema mobile universitário à pesquisa em inteligência
          artificial e à construção de um jogo autoral.
        </p>
      </div>

      <!-- PROJETO I: LUNDGREN ATELIER (VITRINE EDITORIAL 12 COLUNAS COM CAPTURA REAL) -->
      <article class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center pt-4 border-t border-border-subtle">
        <div class="lg:col-span-5 space-y-4">
          <div class="flex items-center justify-between gap-2 text-[13px] leading-normal font-mono">
            <span class="text-accent-text">Desenvolvimento Web · Produção</span>
            <span class="text-text-secondary">2025 — 2026</span>
          </div>

          <h3 class="font-display text-3xl sm:text-4xl font-medium text-text-primary leading-tight">
            Lundgren Atelier
          </h3>

          <p class="text-sm sm:text-base text-text-secondary leading-relaxed">
            Desenvolvimento e publicação do site oficial do Lundgren Atelier. O desafio foi estruturar uma vitrine
            autoral rápida e responsiva em <strong class="text-text-primary font-medium">Astro</strong> e <strong class="text-text-primary font-medium">Tailwind CSS</strong>,
            integrada ao <strong class="text-text-primary font-medium">Sanity.io (Headless CMS)</strong> para gestão de
            obras, com scripts em <strong class="text-text-primary font-medium">Node.js</strong> para migração do acervo
            e publicação contínua no <strong class="text-text-primary font-medium">Cloudflare Pages</strong>.
          </p>

          <div class="pt-2 border-t border-border-subtle space-y-2.5">
            <div class="flex flex-wrap gap-2 text-[13px] leading-normal font-mono text-text-secondary">
              <span>Astro</span>
              <span aria-hidden="true">·</span>
              <span>Sanity.io</span>
              <span aria-hidden="true">·</span>
              <span>Tailwind CSS</span>
              <span aria-hidden="true">·</span>
              <span>Node.js</span>
              <span aria-hidden="true">·</span>
              <span>Cloudflare Pages</span>
            </div>

            <div>
              <a
                href="https://lundgren-atelier.com/"
                target="_blank"
                rel="noopener noreferrer"
                class="min-h-[44px] inline-flex items-center text-sm font-medium text-accent-text hover:underline"
              >
                Visitar lundgren-atelier.com ↗
              </a>
            </div>
          </div>
        </div>

        <div class="lg:col-span-7">
          <figure class="border border-border-control/50 bg-bg-surface shadow-sm overflow-hidden">
            <div class="px-4 py-2 border-b border-border-subtle bg-bg-elevated flex items-center justify-between text-[13px] leading-normal font-mono text-text-secondary">
              <div class="flex items-center gap-1.5" aria-hidden="true">
                <span class="w-2.5 h-2.5 rounded-full bg-border-control/60"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-border-control/60"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-border-control/60"></span>
              </div>
              <span>https://lundgren-atelier.com/</span>
              <span>Em produção</span>
            </div>
            <img
              src="/images/projetos/lundgren-atelier-home.png"
              alt="Captura real da página inicial do site Lundgren Atelier em produção"
              width="2160"
              height="1350"
              fetchpriority="high"
              decoding="async"
              class="w-full h-auto block"
            />
          </figure>
        </div>
      </article>

      <!-- PROJETO II: BIOACÚSTICA (LÂMINA DE PESQUISA CIENTÍFICA + PALCO ESCURO PONTUAL) -->
      <article class="pt-10 border-t border-border-subtle">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          <div class="lg:col-span-6 space-y-4">
            <div class="flex flex-wrap items-center gap-3 text-[13px] leading-normal font-mono">
              <span class="text-metric-accent font-medium">Artigo em Anais · VII CoBICET (2026)</span>
              <span class="text-text-secondary">ISSN 2764-0582</span>
            </div>

            <h3 class="font-display text-3xl sm:text-4xl font-medium text-text-primary leading-tight">
              Detecção Acústica de Aves Ameaçadas Utilizando Aprendizado de Máquina
            </h3>

            <p class="text-sm sm:text-base text-text-secondary leading-relaxed">
              Pesquisa de iniciação científica e TCC desenvolvida no IF Sudeste MG em coautoria com o Prof. Maurício
              Archanjo Nunes Coelho. Investigamos como identificar automaticamente <strong class="text-text-primary font-medium">136 espécies de aves ameaçadas</strong> a
              partir de gravações do repositório <strong class="text-text-primary font-medium">Xeno-Canto</strong>,
              extraindo <strong class="text-text-primary font-medium">Espectrogramas Mel</strong> e coeficientes <strong class="text-text-primary font-medium">MFCC</strong> para
              avaliar três famílias de classificadores: <strong class="text-text-primary font-medium">SVM (MVS)</strong>,
              <strong class="text-text-primary font-medium">GMM-HMM (MOM)</strong> e <strong class="text-text-primary font-medium">Redes Neurais Convolucionais (CNN / RNC)</strong>.
            </p>

            <div class="pt-1 flex flex-wrap items-center gap-5">
              <a
                href={contactLinks.lattesUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="min-h-[44px] inline-flex items-center text-sm font-medium text-accent-text hover:underline"
              >
                Ver registro no Currículo Lattes ↗
              </a>
              <span class="text-[13px] leading-normal font-mono text-text-secondary">
                Código e figuras experimentais em organização para publicação
              </span>
            </div>
          </div>

          <!-- Palco Científico de Alto Contraste (Elemento Pontual da Direção 2) -->
          <div class="lg:col-span-6 bg-stage-bg text-stage-text border border-stage-border p-6 sm:p-7 space-y-5">
            <div class="flex flex-wrap items-center justify-between gap-2 border-b border-stage-border pb-3 text-[13px] leading-normal font-mono">
              <span class="text-stage-amber">DESENHO EXPERIMENTAL · 136 ESPÉCIES</span>
              <span class="text-stage-muted">XENO-CANTO · MEL & MFCC</span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="border border-stage-border bg-stage-surface p-4 space-y-1.5">
                <div class="text-[13px] leading-normal font-mono text-stage-muted">01 · LINHA DE BASE</div>
                <h4 class="font-display text-lg font-medium text-stage-text">Cenário A (Controle)</h4>
                <p class="text-[13px] leading-relaxed text-stage-muted">
                  Configuração inicial de referência para avaliar o comportamento dos classificadores sobre os sinais
                  acústicos sem o refinamento proposto.
                </p>
              </div>

              <div class="border border-stage-amber/60 bg-stage-surface p-4 space-y-1.5">
                <div class="text-[13px] leading-normal font-mono text-stage-amber">02 · CONFIGURAÇÃO REFINADA</div>
                <h4 class="font-display text-lg font-medium text-stage-text">Cenário B (Proposto)</h4>
                <p class="text-[13px] leading-relaxed text-stage-muted">
                  Pipeline espectral refinado avaliado com SVM, GMM-HMM e CNN, no qual a <strong class="text-stage-text font-medium">CNN alcançou F1-weighted de 0,82</strong>.
                </p>
              </div>
            </div>

            <div class="pt-2 border-t border-stage-border flex flex-wrap items-center justify-between gap-3 text-[13px] leading-normal font-mono">
              <span class="text-stage-green">Resultado CNN (Cenário B): F1-weighted = 0,82</span>
              <span class="text-stage-muted">Publicado no VII CoBICET · Apresentado no XVIII EAMC</span>
            </div>
          </div>
        </div>
      </article>

      <!-- PROJETO III: SHAPEMEAPP (ESTUDO DE CASO DE EXTENSÃO & ARQUITETURA MULTI-MÓDULO) -->
      <article class="pt-10 border-t border-border-subtle grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">
        <div class="lg:col-span-6 space-y-4">
          <div class="flex flex-wrap items-center gap-3 text-[13px] leading-normal font-mono">
            <span class="text-accent-text">Desenvolvimento Mobile & Extensão · IF Sudeste MG</span>
            <span class="text-text-secondary">2024 — 2026</span>
          </div>

          <h3 class="font-display text-3xl sm:text-4xl font-medium text-text-primary leading-tight">
            ShapeMeApp
          </h3>

          <p class="text-sm sm:text-base text-text-secondary leading-relaxed">
            Ecossistema desenvolvido no projeto de extensão <em class="text-text-primary">"Emagreça na Musculação no IF Sudeste MG — Campus Rio Pomba"</em>.
            O sistema organiza o acompanhamento diário de treinos e avaliações físicas por meio de três aplicações
            integradas (<strong class="text-text-primary font-medium">Aluno</strong>, <strong class="text-text-primary font-medium">Professor</strong> e <strong class="text-text-primary font-medium">Coordenador</strong>) e
            uma versão web responsiva com <strong class="text-text-primary font-medium">Expo Router</strong>.
          </p>

          <p class="text-sm text-text-secondary leading-relaxed">
            Atuei na evolução das interfaces em <strong class="text-text-primary font-medium">React Native</strong>, na
            modelagem NoSQL no <strong class="text-text-primary font-medium">Firebase (Auth & Firestore)</strong>, nos
            cálculos de carga de treinamento (<strong class="text-text-primary font-medium">CIT, Monotonia e Strain</strong>) e nos testes de usabilidade e QA com usuários reais — trabalho apresentado no <strong class="text-text-primary font-medium">VII SIMEPE (2025)</strong>.
          </p>

          <div class="pt-1 flex flex-wrap items-center gap-5">
            <a
              href="https://github.com/Juanzit/ShapeMeApp"
              target="_blank"
              rel="noopener noreferrer"
              class="min-h-[44px] inline-flex items-center text-sm font-medium text-accent-text hover:underline"
            >
              Monorepo no GitHub ↗
            </a>
            <a
              href="https://github.com/Juanzit/SmaAlunoWeb"
              target="_blank"
              rel="noopener noreferrer"
              class="min-h-[44px] inline-flex items-center text-sm font-medium text-accent-text hover:underline"
            >
              Módulo Web (SmaAlunoWeb) ↗
            </a>
            <a
              href="https://github.com/Juanzit/SMA_Professor"
              target="_blank"
              rel="noopener noreferrer"
              class="min-h-[44px] inline-flex items-center text-sm font-medium text-accent-text hover:underline"
            >
              Módulo Professor ↗
            </a>
          </div>
        </div>

        <div class="lg:col-span-6 bg-bg-surface border border-border-subtle p-6 space-y-4">
          <div class="flex items-center justify-between border-b border-border-subtle pb-2.5 text-[13px] leading-normal font-mono">
            <span class="text-text-primary font-medium">Arquitetura do Ecossistema Monorepo</span>
            <span class="text-metric-accent">React Native · Expo · Firebase</span>
          </div>

          <div class="divide-y divide-border-subtle">
            <div class="py-3 first:pt-0 space-y-1">
              <div class="flex items-center justify-between text-[13px] leading-normal font-mono">
                <span class="text-accent-text">Módulo 01 · Mobile & Web (Expo Router)</span>
                <span class="text-text-secondary">SMA_Aluno / SmaAlunoWeb</span>
              </div>
              <p class="text-sm text-text-secondary leading-relaxed">
                Consulta de fichas de treino, registro de Percepção Subjetiva de Esforço (PSE) e sincronização em nuvem.
              </p>
            </div>

            <div class="py-3 space-y-1">
              <div class="flex items-center justify-between text-[13px] leading-normal font-mono">
                <span class="text-accent-text">Módulo 02 · Acompanhamento & Gráficos</span>
                <span class="text-text-secondary">SMA_Professor</span>
              </div>
              <p class="text-sm text-text-secondary leading-relaxed">
                Gestão de presença, avaliações físicas (dinamometria, resistência abdominal, sentar e alcançar), gráficos
                evolutivos em Victory Native e exportação de dados.
              </p>
            </div>

            <div class="py-3 last:pb-0 space-y-1">
              <div class="flex items-center justify-between text-[13px] leading-normal font-mono">
                <span class="text-accent-text">Módulo 03 · Gestão do Projeto</span>
                <span class="text-text-secondary">SMACoordenador</span>
              </div>
              <p class="text-sm text-text-secondary leading-relaxed">
                Supervisão de turmas, professores e indicadores consolidados do projeto de extensão no campus.
              </p>
            </div>
          </div>
        </div>
      </article>

      <!-- PROJETO IV: NÚCLEO SELVAGEM (PALCO ESCURO IMERSIVO DE GAME DEV — DIREÇÃO 2 PONTUAL) -->
      <article class="bg-stage-bg text-stage-text border border-stage-border p-6 sm:p-8 space-y-6">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-end border-b border-stage-border pb-6">
          <div class="lg:col-span-8 space-y-2.5">
            <div class="flex flex-wrap items-center gap-3 text-[13px] leading-normal font-mono">
              <span class="text-stage-amber">Game Development · Projeto Autoral</span>
              <span class="text-stage-muted">Roblox Studio · Luau · Blender 3D</span>
            </div>

            <h3 class="font-display text-3xl sm:text-4xl font-medium text-stage-text leading-tight">
              Núcleo Selvagem
            </h3>

            <p class="text-sm sm:text-base text-stage-muted leading-relaxed max-w-[62ch]">
              Roguelite autoral de criaturas mutantes em desenvolvimento. O jogo combina incursões de exploração,
              evolução genética modular e gerenciamento da Base Pessoal 2.0, unindo programação de sistemas em <strong class="text-stage-text font-medium">Luau</strong> e
              modelagem 3D autoral no <strong class="text-stage-text font-medium">Blender</strong>.
            </p>
          </div>

          <div class="lg:col-span-4 lg:text-right">
            <a
              href="#contato"
              class="min-h-[44px] px-5 py-2.5 inline-flex items-center justify-center border border-stage-amber text-stage-amber hover:bg-stage-amber hover:text-stage-bg font-mono text-[13px] leading-normal font-medium transition-colors"
            >
              Conversar sobre o projeto ↓
            </a>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="space-y-1.5">
            <div class="text-[13px] leading-normal font-mono text-stage-amber">I · Ciclo de Expedições</div>
            <h4 class="font-display text-xl font-medium text-stage-text">Incursões Roguelite</h4>
            <p class="text-sm text-stage-muted leading-relaxed">
              Partidas estruturadas em expedições de risco e recompensa, coleta de material genético e retorno
              estratégico com validação de estado entre cliente e servidor.
            </p>
          </div>

          <div class="space-y-1.5">
            <div class="text-[13px] leading-normal font-mono text-stage-amber">II · Criaturas & Mutações</div>
            <h4 class="font-display text-xl font-medium text-stage-text">Evolução Genética Modular</h4>
            <p class="text-sm text-stage-muted leading-relaxed">
              Composição orientada a dados em Luau onde mutações alteram morfologia e atributos de combate de criaturas
              modeladas em 3D no Blender.
            </p>
          </div>

          <div class="space-y-1.5">
            <div class="text-[13px] leading-normal font-mono text-stage-amber">III · Persistência</div>
            <h4 class="font-display text-xl font-medium text-stage-text">Base Pessoal 2.0</h4>
            <p class="text-sm text-stage-muted leading-relaxed">
              Sistema de gerenciamento e progressão persistente da base do jogador entre sessões no Roblox Studio.
            </p>
          </div>
        </div>
      </article>
    </section>

    <!-- 3. SELEÇÃO COMPACTA DE OUTROS PROJETOS & COLABORAÇÕES (#github) -->
    <section id="github" aria-labelledby="github-heading" class="py-12 sm:py-16 border-b border-border-subtle space-y-12">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <div class="space-y-2 max-w-[62ch]">
          <p class="text-[13px] leading-normal font-mono text-accent-text">Outros Projetos & GitHub</p>
          <h2
            id="github-heading"
            class="font-display text-3xl sm:text-4xl font-medium tracking-[-0.015em] text-text-primary leading-tight"
          >
            Colaborações, jogos em Python, algoritmos e ensino
          </h2>
          <p class="text-base text-text-secondary leading-relaxed">
            Seleção de trabalhos desenvolvidos em coautoria, projetos autorais de programação e iniciativas abertas na
            universidade.
          </p>
        </div>

        <a
          href={contactLinks.githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="min-h-[44px] px-4 py-2 inline-flex items-center border border-border-control bg-bg-surface hover:border-accent-solid text-sm font-mono text-text-primary transition-colors shrink-0"
        >
          {contactLinks.githubLabel} ↗
        </a>
      </div>

      <!-- A. PROJETO COLABORATIVO: ARCHFLOW (ATRIBUIÇÃO DISTINTA E CAPTURA REAL) -->
      <article class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start pt-4 border-t border-border-subtle">
        <div class="lg:col-span-6 space-y-3.5">
          <div class="flex flex-wrap items-center justify-between gap-2 text-[13px] leading-normal font-mono">
            <span class="text-accent-text">Projeto Colaborativo · Engenharia de Software</span>
            <span class="text-text-secondary">{archFlowProject.stack}</span>
          </div>

          <h3 class="font-display text-2xl sm:text-3xl font-medium text-text-primary leading-snug">
            {archFlowProject.title}
          </h3>

          <p class="text-[13px] leading-normal font-mono text-metric-accent bg-bg-surface px-3 py-2 border-l-2 border-metric-accent">
            {archFlowProject.coauthorshipNote}
          </p>

          <p class="text-sm text-text-secondary leading-relaxed">
            Sistema desktop para gerenciamento de projetos arquitetônicos, terrenos, despesas, documentos, feedback com
            clientes e visualização 3D. {archFlowProject.partnerContributions}
          </p>

          <div class="space-y-1 text-sm text-text-secondary">
            <p class="font-medium text-text-primary">Atividades que implementei no projeto:</p>
            <ul class="list-disc pl-5 space-y-0.5 leading-relaxed">
              {archFlowProject.juanContributions.map((item) => <li>{item}</li>)}
            </ul>
          </div>

          <div class="pt-1">
            <a
              href={archFlowProject.repoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="min-h-[44px] inline-flex items-center text-sm font-medium text-accent-text hover:underline"
            >
              Acessar repositório (Victorlolmi/LPS) ↗
            </a>
          </div>
        </div>

        <div class="lg:col-span-6">
          <figure class="border border-border-control/50 bg-bg-surface p-2.5 space-y-2">
            <img
              src={archFlowProject.screenshots.main.src}
              alt={archFlowProject.screenshots.main.alt}
              width={archFlowProject.screenshots.main.width}
              height={archFlowProject.screenshots.main.height}
              loading="lazy"
              decoding="async"
              class="w-full h-auto block border border-border-subtle"
            />
            <figcaption class="px-1 text-[13px] leading-normal font-mono text-text-secondary">
              {archFlowProject.screenshots.main.caption}
            </figcaption>
          </figure>
        </div>
      </article>

      <!-- B. DESENVOLVIMENTO E PROGRAMAÇÃO: BLADE OF ALBAIA (CAPTURA REAL DE GAMEPLAY + ASSETS VERIFICADOS) -->
      <article class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center pt-8 border-t border-border-subtle">
        <div class="lg:col-span-6">
          <figure class="border border-border-control/50 bg-stage-bg p-3 space-y-2.5">
            <div class="grid grid-cols-12 gap-2.5 items-stretch">
              <div class="col-span-8">
                <img
                  src={bladeOfAlbaiaProject.images.screenshot.src}
                  alt={bladeOfAlbaiaProject.images.screenshot.alt}
                  width={bladeOfAlbaiaProject.images.screenshot.width}
                  height={bladeOfAlbaiaProject.images.screenshot.height}
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover block border border-stage-border"
                />
              </div>
              <div class="col-span-4 flex flex-col justify-between gap-2.5">
                <img
                  src={bladeOfAlbaiaProject.images.menu.src}
                  alt={bladeOfAlbaiaProject.images.menu.alt}
                  width={bladeOfAlbaiaProject.images.menu.width}
                  height={bladeOfAlbaiaProject.images.menu.height}
                  loading="lazy"
                  decoding="async"
                  class="w-full h-auto block border border-stage-border"
                />
                <img
                  src={bladeOfAlbaiaProject.images.fase1.src}
                  alt={bladeOfAlbaiaProject.images.fase1.alt}
                  width={bladeOfAlbaiaProject.images.fase1.width}
                  height={bladeOfAlbaiaProject.images.fase1.height}
                  loading="lazy"
                  decoding="async"
                  class="w-full h-auto block border border-stage-border"
                />
              </div>
            </div>
            <figcaption class="px-1 text-[13px] leading-normal font-mono text-stage-muted">
              Blade of Albaia · Captura de gameplay (`screenshot.png`), menu (`albaiaquestmenu.png`) e Fase 1 (`fase1.png`)
            </figcaption>
          </figure>
        </div>

        <div class="lg:col-span-6 space-y-3">
          <div class="text-[13px] leading-normal font-mono text-accent-text">
            Desenvolvimento & Programação · {bladeOfAlbaiaProject.stack}
          </div>

          <h3 class="font-display text-2xl sm:text-3xl font-medium text-text-primary leading-snug">
            {bladeOfAlbaiaProject.title}
          </h3>

          <p class="text-sm sm:text-base text-text-secondary leading-relaxed">
            {bladeOfAlbaiaProject.summary}
          </p>

          <div class="pt-1">
            <a
              href={bladeOfAlbaiaProject.repoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="min-h-[44px] inline-flex items-center text-sm font-medium text-accent-text hover:underline"
            >
              Ver código e assets no GitHub ↗
            </a>
          </div>
        </div>
      </article>

      <!-- C. ÍNDICE COMPACTO (2x2) DE PESQUISA ACADÊMICA, ALGORITMOS E ENSINO -->
      <div class="pt-8 border-t border-border-subtle space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2">
          <h3 class="font-display text-2xl font-medium text-text-primary">
            Pesquisa Acadêmica, Algoritmos & Ensino Aberto
          </h3>
          <span class="text-[13px] leading-normal font-mono text-text-secondary">
            Seleção compacta de repositórios e materiais didáticos
          </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-6 pt-2">
          {
            compactOtherProjects.map((item) => (
              <article class="border-t border-border-subtle pt-4 flex flex-col justify-between space-y-2">
                <div class="space-y-1">
                  <div class="flex items-center justify-between gap-2 text-[13px] leading-normal font-mono">
                    <span class="text-accent-text">{item.category}</span>
                    <span class="text-text-secondary">{item.stack}</span>
                  </div>
                  <h4 class="font-display text-xl font-medium text-text-primary">{item.title}</h4>
                  <p class="text-sm text-text-secondary leading-relaxed">{item.shortSummary}</p>
                </div>

                <div>
                  <a
                    href={item.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="min-h-[44px] inline-flex items-center text-sm font-medium text-accent-text hover:underline"
                  >
                    {item.linkLabel}
                  </a>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- 4. RESUMO BREVE DA TRAJETÓRIA (EXPERIÊNCIA, FORMAÇÃO & PRODUÇÃO CIENTÍFICA DISTINTA) -->
    <section id="trajetoria" aria-labelledby="trajetoria-heading" class="py-12 sm:py-16 border-b border-border-subtle">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-start">
        <!-- Coluna Esquerda: Síntese de Formação, Publicação em Anais vs. Apresentações e Extensão -->
        <div class="lg:col-span-5 space-y-8">
          <div class="space-y-2.5">
            <p class="text-[13px] leading-normal font-mono text-accent-text">Resumo da Trajetória</p>
            <h2
              id="trajetoria-heading"
              class="font-display text-3xl sm:text-4xl font-medium tracking-[-0.015em] text-text-primary leading-tight"
            >
              Experiência, formação e produção acadêmica
            </h2>
            <p class="text-sm text-text-secondary leading-relaxed">
              Síntese da atuação entre docência em programação, iniciação científica em IA, extensão universitária e
              empresa júnior no IF Sudeste MG.
            </p>
          </div>

          <!-- Formação Acadêmica Compacta -->
          <div id="formacao" class="space-y-3 border-t border-border-subtle pt-5">
            <h3 class="font-mono text-[13px] leading-normal text-accent-text uppercase tracking-wider">
              Formação Acadêmica
            </h3>
            <div class="space-y-3">
              {
                education.map((edu) => (
                  <div class="border-l-2 border-metric-accent pl-4 space-y-0.5">
                    <div class="font-mono text-[13px] leading-normal text-metric-accent">{edu.period}</div>
                    <div class="font-display text-lg font-medium text-text-primary">{edu.degree}</div>
                    <div class="text-sm text-text-secondary">{edu.institution}</div>
                  </div>
                ))
              }
            </div>
          </div>

          <!-- Produção Científica (Distinção estrita entre Publicação em Anais e Apresentação em Evento) -->
          <div id="publicacoes" class="space-y-3 border-t border-border-subtle pt-5">
            <div class="flex items-baseline justify-between gap-2">
              <h3 class="font-mono text-[13px] leading-normal text-accent-text uppercase tracking-wider">
                Publicação & Apresentações
              </h3>
              <a
                href={contactLinks.lattesUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="min-h-[44px] inline-flex items-center font-mono text-[13px] leading-normal text-metric-accent hover:underline"
              >
                Currículo Lattes ↗
              </a>
            </div>

            <div class="space-y-3">
              {
                scientificOutputs.map((pub) => (
                  <div class="bg-bg-surface border border-border-subtle p-3.5 space-y-1">
                    <div class="flex flex-wrap items-center justify-between gap-2 font-mono text-[13px] leading-normal">
                      <span class={pub.category === 'publicacao_anais' ? 'text-metric-accent font-medium' : 'text-accent-text'}>
                        {pub.categoryLabel}
                      </span>
                      <span class="text-text-secondary">
                        {pub.year}{pub.identifier ? ` · ${pub.identifier}` : ''}
                      </span>
                    </div>
                    <div class="font-display text-base font-medium text-text-primary leading-snug">{pub.title}</div>
                    <div class="text-[13px] leading-normal text-text-secondary">{pub.venue}</div>
                  </div>
                ))
              }
            </div>
          </div>

          <!-- Nota Compacta de Extensão & Certificações -->
          <div id="certificacoes" class="border-t border-border-subtle pt-4 text-sm text-text-secondary space-y-1">
            <div class="font-mono text-[13px] leading-normal text-text-primary font-medium">
              Extensão & Certificações Comprovadas
            </div>
            <p class="leading-relaxed">
              Empresa Júnior <strong class="text-text-primary font-medium">EmComp (100h certificadas)</strong>, Monitoria
              Voluntária de <strong class="text-text-primary font-medium">Linguagens Formais e Autômatos (2025)</strong>,
              Minicurso <strong class="text-text-primary font-medium">React com Firebase (2025)</strong> e Instrutor de
              Desenvolvimento Mobile (<strong class="text-text-primary font-medium">16 videoaulas, 2023–2024</strong>).
            </p>
          </div>
        </div>

        <!-- Coluna Direita: Linha do Tempo Resumida de Experiências -->
        <div class="lg:col-span-7 divide-y divide-border-subtle border-t border-b border-border-subtle">
          {
            experiences.map((exp) => (
              <article class="py-4.5 grid grid-cols-1 sm:grid-cols-12 gap-3 items-baseline">
                <div class="sm:col-span-4 space-y-0.5">
                  <div class="font-mono text-[13px] leading-normal text-metric-accent font-medium">{exp.period}</div>
                  <div class="font-medium text-sm text-text-primary">{exp.org}</div>
                  <div class="text-[13px] leading-normal text-text-secondary">{exp.meta}</div>
                </div>

                <div class="sm:col-span-8 space-y-1">
                  <h3 class="font-display text-xl font-medium text-text-primary leading-snug">{exp.role}</h3>
                  <p class="text-sm text-text-secondary leading-relaxed">{exp.shortSummary}</p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- 5. CONTATO DIRETO (COM LINKEDIN, E-MAIL, GITHUB E LATTES) -->
    <section id="contato" aria-labelledby="contato-heading" class="py-12 sm:py-16">
      <div class="bg-bg-surface border border-border-subtle p-6 sm:p-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-6 space-y-3">
          <p class="text-[13px] leading-normal font-mono text-accent-text">Contato Direto</p>
          <h2
            id="contato-heading"
            class="font-display text-3xl sm:text-4xl font-medium tracking-[-0.015em] text-text-primary leading-tight"
          >
            Vamos conversar sobre desenvolvimento, pesquisa ou novos projetos?
          </h2>
          <p class="text-sm sm:text-base text-text-secondary leading-relaxed max-w-[54ch]">
            Estou disponível para oportunidades em desenvolvimento de software, projetos de pesquisa aplicada em IA,
            colaborações técnicas ou ensino de programação.
          </p>
        </div>

        <div class="lg:col-span-6 grid grid-cols-1 sm:grid-cols-2 gap-3">
          <a
            href={`mailto:${contactLinks.email}`}
            class="sm:col-span-2 min-h-[44px] px-5 py-3 flex items-center justify-between bg-accent-solid hover:bg-accent-solid-hover text-white font-mono text-[13px] leading-normal transition-colors"
          >
            <span>{contactLinks.email}</span>
            <span aria-hidden="true">↗</span>
          </a>

          <a
            href={contactLinks.linkedinUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="min-h-[44px] px-4 py-3 flex items-center justify-between gap-2 border border-border-control bg-bg-canvas hover:border-accent-solid text-text-primary font-mono text-[13px] leading-normal whitespace-nowrap transition-colors"
          >
            <span>{contactLinks.linkedinLabel}</span>
            <span class="text-accent-text" aria-hidden="true">↗</span>
          </a>

          <a
            href={contactLinks.githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="min-h-[44px] px-4 py-3 flex items-center justify-between gap-2 border border-border-control bg-bg-canvas hover:border-accent-solid text-text-primary font-mono text-[13px] leading-normal whitespace-nowrap transition-colors"
          >
            <span>{contactLinks.githubLabel}</span>
            <span class="text-accent-text" aria-hidden="true">↗</span>
          </a>

          <a
            href={contactLinks.lattesUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="sm:col-span-2 min-h-[44px] px-4 py-3 flex items-center justify-between border border-border-control bg-bg-canvas hover:border-accent-solid text-text-primary font-mono text-[13px] leading-normal transition-colors"
          >
            <span>{contactLinks.lattesLabel} — lattes.cnpq.br/9434044887106048</span>
            <span class="text-metric-accent" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Badge from '../components/ui/Badge.astro';

const projects = [
  {
    code: 'PRJ-01',
    category: 'ENGENHARIA WEB & ARQUITETURA ESCALÁVEL',
    status: 'EM PRODUÇÃO',
    statusVariant: 'success' as const,
    title: 'Lundgren Atelier — Plataforma Digital Sob Medida',
    summary:
      'Desenvolvimento completo e publicação em produção de plataforma web sob encomenda (Out 2025 – Jan 2026), com foco em arquitetura escalável, experiência do usuário responsiva, SEO técnico e entrega contínua.',
    metrics: 'Deploy em Produção • Domínio Customizado',
    stack: ['Arquitetura Escalável', 'Frontend Responsivo', 'SEO Técnico', 'Produção Real'],
    links: [{ label: 'Visitar lundgrenatelier.com ↗', href: 'https://www.lundgrenatelier.com/', external: true }],
  },
  {
    code: 'PRJ-02',
    category: 'PESQUISA EM IA & PROCESSAMENTO DE SINAIS',
    status: 'PUBLICADO (VII CoBICET)',
    statusVariant: 'accent' as const,
    title: 'Detecção Acústica de Aves Ameaçadas com Machine Learning',
    summary:
      'Investigação experimental comparando Cenário A (Controle) e Cenário B (Proposto) sobre registros do repositório Xeno-Canto. Extração de espectrogramas Mel e coeficientes MFCC avaliados em arquiteturas SVM, GMM-HMM e Redes Neurais Convolucionais (CNN).',
    metrics: 'CNN F1-weighted: 0,82 (~82% Acurácia) • ISSN 2764-0582',
    stack: ['Python', 'TensorFlow / Keras', 'Scikit-Learn', 'Librosa (MFCC / Mel)', 'Xeno-Canto'],
    links: [{ label: 'Especificação do Estudo (Fase 4)', href: '#projetos', external: false }],
  },
  {
    code: 'PRJ-03',
    category: 'ENGENHARIA MOBILE & EXTENSÃO TECNOLÓGICA',
    status: 'PROJETO INSTITUCIONAL',
    statusVariant: 'accent' as const,
    title: 'ShapeMeApp — Monitoramento Esportivo e Prevenção de Lesões',
    summary:
      'Aplicativo multiplataforma desenvolvido no IF Sudeste MG (Mai 2024 – Set 2025) para cálculo automatizado da Carga Interna de Treinamento (CIT = PSE × Duração em minutos) e acompanhamento longitudinal de atletas e treinadores.',
    metrics: 'Apresentado no SIMEPE 2025 • Persistência em Tempo Real',
    stack: ['React Native', 'TypeScript', 'Firebase', 'Arquitetura Mobile', 'Ciências do Esporte'],
    links: [{ label: 'Repositório GitHub ↗', href: 'https://github.com/Juan-Garcia01', external: true }],
  },
  {
    code: 'PRJ-04',
    category: 'GAME DEVELOPMENT & SISTEMAS INTERATIVOS',
    status: 'EM DESENVOLVIMENTO',
    statusVariant: 'neutral' as const,
    title: 'Núcleo Selvagem — Arquitetura Modular Client/Server',
    summary:
      'Projeto autoral de jogo digital focado em evolução biológica, combate tático e estados reativos. Estruturado com separação rigorosa entre simulação autoritativa no servidor e feedback visual responsivo no cliente.',
    metrics: 'Arquitetura Modular • Estados e Mutações em Tempo Real',
    stack: ['Luau', 'Roblox Studio', 'Client/Server Architecture', 'State Machines', 'Game Systems'],
    links: [{ label: 'Explorar Game Lab ↓', href: '#game-lab', external: false }],
  },
];

const experiences = [
  {
    period: 'MAR 2026 — ATUAL',
    role: 'Facilitador de Conversação em Inglês',
    org: 'CNA Idiomas Digital',
    tag: 'COMUNICAÇÃO INTERNACIONAL',
    description:
      'Condução de sessões estruturadas de conversação em língua inglesa em ambiente digital, aprimorando fluência técnica, clareza expositiva e mediação em tempo real.',
  },
  {
    period: 'NOV 2025 — ATUAL',
    role: 'Professor Tutor de Programação (Python & Roblox Studio)',
    org: 'Kodland',
    tag: 'ENSINO INTERNACIONAL DE TECNOLOGIA',
    description:
      'Ensino prático de lógica de programação, desenvolvimento de algoritmos em Python e engenharia de jogos em Luau/Roblox Studio para turmas jovens, traduzindo conceitos de arquitetura de software em projetos interativos.',
  },
  {
    period: 'OUT 2024 — SET 2025',
    role: 'Pesquisador de Iniciação Científica — Bioacústica & IA',
    org: 'IF Sudeste MG — Campus Rio Pomba',
    tag: 'PESQUISA CIENTÍFICA PUBLICADA',
    description:
      'Desenvolvimento de pipelines de pré-processamento acústico e modelos supervisionados (SVM, GMM-HMM e CNN) para classificação de espécies ameaçadas. Pesquisa publicada como capítulo nos Anais do VII CoBICET (2026) e apresentada no SIMEPE 2025.',
  },
  {
    period: 'MAI 2024 — SET 2025',
    role: 'Desenvolvedor Mobile — Projeto ShapeMeApp',
    org: 'IF Sudeste MG — Campus Rio Pomba',
    tag: 'DESENVOLVIMENTO MOBILE & EXTENSÃO',
    description:
      'Implementação de interfaces reativas em React Native e integração com Firebase para coleta de Percepção Subjetiva de Esforço (PSE) e análise de cargas de treinamento esportivo.',
  },
  {
    period: 'ABR 2024 — AGO 2024',
    role: 'Instrutor de Programação Orientada a Objetos em Java',
    org: 'IF Sudeste MG — Projeto de Extensão',
    tag: 'DOCÊNCIA TÉCNICA',
    description:
      'Formação técnica de estudantes em fundamentos de orientação a objetos, encapsulamento, herança, polimorfismo e boas práticas de projeto na linguagem Java.',
  },
  {
    period: 'SET 2023 — SET 2024',
    role: 'Diretor de Marketing & Desenvolvedor Front-End',
    org: 'EmComp — Empresa Júnior de Computação (IF Sudeste MG)',
    tag: 'LIDERANÇA & DESENVOLVIMENTO WEB',
    description:
      'Atuação dupla na gestão de comunicação institucional da empresa júnior e na implementação de interfaces web responsivas para clientes externos e projetos internos.',
  },
];

const journalPreviews = [
  {
    code: 'CADERNO-01',
    category: 'PESQUISA EM IA & SINAIS',
    title: 'Espectrogramas Mel e MFCC na Classificação de Aves Ameaçadas: Cenário A vs. Cenário B',
    excerpt:
      'Análise técnica de como a representação tempo-frequência e o balanceamento espectral impactaram a transição de modelos estatísticos clássicos (SVM e GMM-HMM) para Redes Neurais Convolucionais com F1-weighted de 0,82.',
    meta: 'Baseado na publicação VII CoBICET (ISSN 2764-0582)',
  },
  {
    code: 'CADERNO-02',
    category: 'ENGENHARIA MOBILE',
    title: 'Modelagem de Carga Interna de Treinamento (PSE × Duração) com React Native e Firebase',
    excerpt:
      'Decisões arquiteturais do ShapeMeApp para transformar escalas clínicas de percepção de esforço em séries temporais acionáveis para prevenção de lesões no esporte.',
    meta: 'Estudo de Caso Institucional — SIMEPE 2025',
  },
  {
    code: 'CADERNO-03',
    category: 'SISTEMAS DE JOGOS',
    title: 'Desacoplamento Client/Server e Máquinas de Estado em Sistemas de Combate e Mutação',
    excerpt:
      'Padrões de engenharia aplicados no projeto Núcleo Selvagem e no ensino de programação de jogos para garantir validação autoritativa e responsividade visual.',
    meta: 'Notas de Arquitetura — Luau & Game Systems',
  },
];

const skillGroups = [
  {
    title: 'Linguagens & Fundamentos',
    code: 'GRP-01',
    items: [
      'Python',
      'TypeScript',
      'JavaScript (ES6+)',
      'Java (POO)',
      'C++',
      'SQL',
      'Luau',
      'Estruturas de Dados & Algoritmos',
    ],
  },
  {
    title: 'Engenharia Web & Mobile',
    code: 'GRP-02',
    items: [
      'React Native',
      'React',
      'Astro',
      'Node.js',
      'Tailwind CSS',
      'HTML5 & CSS3 Semântico',
      'Firebase (Auth / Firestore)',
      'Arquitetura REST',
    ],
  },
  {
    title: 'IA, Ciência de Dados & Bioacústica',
    code: 'GRP-03',
    items: [
      'TensorFlow & Keras',
      'Scikit-Learn (SVM / Métricas)',
      'Redes Neurais Convolucionais (CNN)',
      'GMM-HMM',
      'Processamento Digital de Sinais (MFCC / Mel)',
      'Pandas & NumPy',
    ],
  },
  {
    title: 'Game Dev, Ferramentas & Idiomas',
    code: 'GRP-04',
    items: [
      'Roblox Studio (Arquitetura Luau)',
      'Sistemas Modulares Client/Server',
      'Git & GitHub',
      'Linux & Linha de Comando',
      'Metodologias Ágeis (Scrum)',
      'Inglês Avançado (Conversação & Docência)',
    ],
  },
];
---

<BaseLayout
  title="Juan Silva Garcia — Engenharia de Software, Pesquisa em IA & Sistemas Interativos"
  description="Portfólio profissional e acadêmico de Juan Silva Garcia. Graduando em Ciência da Computação (IF Sudeste MG), desenvolvedor de software, pesquisador publicado em Inteligência Artificial aplicada à bioacústica e criador de sistemas interativos."
>
  <Header />

  <main id="main-content" tabindex="-1" class="max-w-[1120px] mx-auto px-4 sm:px-8">
    <!-- 1. HERO SECTION -->
    <section aria-labelledby="hero-heading" class="py-12 sm:py-20 border-b border-border-subtle">
      <div class="flex flex-wrap items-center gap-2.5 mb-6">
        <Badge variant="success">DISPONÍVEL PARA PROJETOS & P&D</Badge>
        <Badge variant="accent">CIÊNCIA DA COMPUTAÇÃO — IF SUDESTE MG</Badge>
        <Badge variant="neutral">RIO POMBA, MG — BRASIL</Badge>
      </div>

      <h1
        id="hero-heading"
        class="text-3xl sm:text-5xl font-bold tracking-[-0.025em] text-text-primary leading-[1.12] max-w-[22ch]"
      >
        Engenharia de Software, Pesquisa em IA e Sistemas Interativos.
      </h1>

      <p class="mt-6 text-base sm:text-lg text-text-secondary leading-[1.65] max-w-[65ch]">
        Sou <strong class="text-text-primary font-semibold">Juan Silva Garcia</strong>, graduando no 7º período de
        Ciência da Computação pelo IF Sudeste MG. Desenvolvo aplicações web e mobile em produção, pesquiso
        aprendizado de máquina aplicado ao processamento de sinais bioacústicos e projeto arquiteturas modulares para
        jogos digitais e ensino técnico.
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-3.5">
        <a
          href="#projetos"
          class="min-h-[44px] px-6 py-2.5 inline-flex items-center justify-center bg-accent-solid hover:bg-accent-solid-hover text-white font-medium text-sm transition-colors"
        >
          Explorar Projetos & Pesquisa
        </a>
        <a
          href="#experiencia"
          class="min-h-[44px] px-6 py-2.5 inline-flex items-center justify-center bg-bg-surface hover:bg-bg-elevated text-text-primary border border-border-control hover:border-accent-text font-medium text-sm transition-colors"
        >
          Ver Trajetória Completa
        </a>
        <a
          href="http://lattes.cnpq.br/9434044887106048"
          target="_blank"
          rel="noopener noreferrer"
          class="min-h-[44px] px-4 py-2.5 inline-flex items-center justify-center font-mono text-[13px] leading-normal text-accent-text hover:underline"
        >
          Currículo Lattes (CNPq) ↗
        </a>
      </div>

      <!-- Painel Técnico de Credenciais Rápidas -->
      <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="border border-border-subtle bg-bg-surface p-5 space-y-1.5">
          <div class="flex items-center justify-between font-mono text-[13px] leading-normal text-text-secondary">
            <span>PUBLICAÇÃO CIENTÍFICA</span>
            <span class="text-metric-accent">2026</span>
          </div>
          <p class="text-base font-semibold text-text-primary">Anais VII CoBICET (ISSN 2764-0582)</p>
          <p class="text-[13px] text-text-secondary leading-normal">
            Classificação bioacústica de aves ameaçadas com CNN atingindo F1-weighted de 0,82 (~82% de acurácia).
          </p>
        </div>

        <div class="border border-border-subtle bg-bg-surface p-5 space-y-1.5">
          <div class="flex items-center justify-between font-mono text-[13px] leading-normal text-text-secondary">
            <span>ENGENHARIA DE SOFTWARE</span>
            <span class="text-metric-accent">PRODUÇÃO</span>
          </div>
          <p class="text-base font-semibold text-text-primary">Web Freelance & Extensão Mobile</p>
          <p class="text-[13px] text-text-secondary leading-normal">
            Plataforma Lundgren Atelier em domínio próprio e aplicativo multiplataforma ShapeMeApp (React Native +
            Firebase).
          </p>
        </div>

        <div class="border border-border-subtle bg-bg-surface p-5 space-y-1.5">
          <div class="flex items-center justify-between font-mono text-[13px] leading-normal text-text-secondary">
            <span>DOCÊNCIA & COMUNICAÇÃO</span>
            <span class="text-metric-accent">ATIVO</span>
          </div>
          <p class="text-base font-semibold text-text-primary">Professor Tutor (Kodland & CNA)</p>
          <p class="text-[13px] text-text-secondary leading-normal">
            Ensino de Python, arquitetura Luau/Roblox Studio e facilitação de conversação avançada em inglês.
          </p>
        </div>
      </div>
    </section>

    <!-- 2. APRESENTAÇÃO / PERFIL DE ENGENHARIA -->
    <section id="apresentacao" aria-labelledby="apresentacao-heading" class="py-16 border-b border-border-subtle">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <div class="lg:col-span-5 space-y-3">
          <span class="font-mono text-[13px] leading-normal uppercase tracking-wider text-accent-text block">
            00. Perfil Técnico & Abordagem de Engenharia
          </span>
          <h2 id="apresentacao-heading" class="text-2xl font-semibold tracking-[-0.015em] text-text-primary">
            Rigor científico aliado à entrega de software funcional.
          </h2>
          <p class="text-sm text-text-secondary leading-relaxed">
            Minha formação no IF Sudeste MG combina base matemática sólida, experimentação controlada em Inteligência
            Artificial e desenvolvimento de produtos reais para web, dispositivos móveis e ambientes interativos.
          </p>
        </div>

        <div class="lg:col-span-7 border border-border-subtle bg-bg-surface p-6 space-y-4">
          <div class="flex items-center justify-between border-b border-border-subtle pb-3 font-mono text-[13px] leading-normal">
            <span class="text-accent-text">FORMAÇÃO & CREDENCIAIS COMPROVADAS</span>
            <span class="text-metric-accent">VERIFICADO</span>
          </div>

          <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
            <div class="space-y-1">
              <dt class="font-mono text-[13px] leading-normal text-text-secondary">GRADUAÇÃO PRINCIPAL</dt>
              <dd class="font-medium text-text-primary">Bacharelado em Ciência da Computação (2022–2026)</dd>
              <dd class="text-[13px] leading-normal text-text-secondary">IF Sudeste MG — Campus Rio Pomba</dd>
            </div>

            <div class="space-y-1">
              <dt class="font-mono text-[13px] leading-normal text-text-secondary">BASE TÉCNICA ANTERIOR</dt>
              <dd class="font-medium text-text-primary">Técnico em Agroecologia (2019–2021)</dd>
              <dd class="text-[13px] leading-normal text-text-secondary">
                IF Sudeste MG — Base interdisciplinar para pesquisa ambiental e bioacústica
              </dd>
            </div>

            <div class="space-y-1">
              <dt class="font-mono text-[13px] leading-normal text-text-secondary">EVENTOS & SIMPÓSIOS</dt>
              <dd class="font-medium text-text-primary">Expositor no SIMEPE 2025</dd>
              <dd class="text-[13px] leading-normal text-text-secondary">
                Apresentação oral e técnica de pesquisas em IA e desenvolvimento mobile
              </dd>
            </div>

            <div class="space-y-1">
              <dt class="font-mono text-[13px] leading-normal text-text-secondary">REGISTRO CIENTÍFICO</dt>
              <dd class="font-medium text-text-primary">Capítulo Publicado — VII CoBICET</dd>
              <dd class="text-[13px] leading-normal font-mono text-metric-accent">ISSN: 2764-0582 (2026)</dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    <!-- 3. VITRINE DE PROJETOS (4 PILARES) -->
    <section id="projetos" aria-labelledby="projetos-heading" class="py-16 border-b border-border-subtle space-y-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <div class="space-y-2">
          <span class="font-mono text-[13px] leading-normal uppercase tracking-wider text-accent-text block">
            01. Projetos Selecionados & Pesquisa Aplicada
          </span>
          <h2 id="projetos-heading" class="text-2xl sm:text-3xl font-semibold tracking-[-0.015em] text-text-primary">
            Sistemas em Produção, Mobile e Inteligência Artificial
          </h2>
        </div>
        <p class="font-mono text-[13px] leading-normal text-text-secondary">
          4 PROJETOS PRINCIPAIS • DADOS AUDITADOS
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {
          projects.map((project) => (
            <article class="border border-border-subtle bg-bg-surface hover:border-accent-primary transition-colors p-6 flex flex-col justify-between space-y-6">
              <div class="space-y-4">
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <span class="font-mono text-[13px] leading-normal text-accent-text">
                    {project.code} // {project.category}
                  </span>
                  <Badge variant={project.statusVariant}>{project.status}</Badge>
                </div>

                <h3 class="text-xl font-semibold text-text-primary leading-snug">{project.title}</h3>

                <p class="text-sm text-text-secondary leading-relaxed">{project.summary}</p>
              </div>

              <div class="space-y-4 pt-4 border-t border-border-subtle">
                <div class="flex items-center justify-between font-mono text-[13px] leading-normal">
                  <span class="text-text-secondary">INDICADOR TÉCNICO</span>
                  <span class="text-metric-accent font-medium">{project.metrics}</span>
                </div>

                <div class="flex flex-wrap gap-1.5">
                  {project.stack.map((tech) => (
                    <span class="px-2 py-0.5 bg-bg-canvas border border-border-subtle font-mono text-[13px] leading-normal text-text-secondary">
                      {tech}
                    </span>
                  ))}
                </div>

                <div class="pt-1 flex flex-wrap items-center gap-4">
                  {project.links.map((link) => (
                    <a
                      href={link.href}
                      target={link.external ? '_blank' : undefined}
                      rel={link.external ? 'noopener noreferrer' : undefined}
                      class="min-h-[44px] inline-flex items-center text-sm font-mono text-accent-text hover:underline"
                    >
                      {link.label}
                    </a>
                  ))}
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- 4. GAME DEVELOPMENT LAB (SEÇÃO DEDICADA) -->
    <section id="game-lab" aria-labelledby="gamelab-heading" class="py-16 border-b border-border-subtle space-y-8">
      <div class="space-y-2">
        <span class="font-mono text-[13px] leading-normal uppercase tracking-wider text-accent-text block">
          02. Game Development Lab — Núcleo Selvagem
        </span>
        <h2 id="gamelab-heading" class="text-2xl sm:text-3xl font-semibold tracking-[-0.015em] text-text-primary">
          Engenharia de Sistemas Interativos e Arquitetura Luau
        </h2>
        <p class="text-sm sm:text-base text-text-secondary max-w-[65ch] leading-relaxed">
          Mais do que entretenimento, o desenvolvimento de jogos exige controle rigoroso de estado, sincronização em
          rede e baixa latência. No projeto autoral <strong class="text-text-primary">Núcleo Selvagem</strong> e na
          docência na <strong class="text-text-primary">Kodland</strong>, aplico padrões de engenharia de software para
          construir mecânicas modulares e escaláveis.
        </p>
      </div>

      <div class="border border-border-subtle bg-bg-surface">
        <div class="px-5 py-3.5 border-b border-border-subtle bg-bg-elevated flex flex-wrap items-center justify-between gap-4">
          <div class="flex items-center gap-3">
            <span class="w-2.5 h-2.5 rounded-full bg-metric-accent" aria-hidden="true"></span>
            <span class="font-mono text-[13px] leading-normal font-medium text-text-primary">
              ARQUITETURA DE SISTEMAS — NÚCLEO SELVAGEM (ROBLOX STUDIO / LUAU)
            </span>
          </div>
          <span class="font-mono text-[13px] leading-normal text-accent-text">CLIENT / SERVER SEPARATION</span>
        </div>

        <div class="p-6 grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="border border-border-subtle bg-bg-canvas p-5 space-y-2">
            <div class="font-mono text-[13px] leading-normal text-accent-text">SYS-01 // COMBATE & FÍSICA</div>
            <h3 class="text-base font-semibold text-text-primary">Validação Autoritativa no Servidor</h3>
            <p class="text-[13px] text-text-secondary leading-relaxed">
              Separação entre predição visual no cliente e cálculo real de colisão, dano e tempo de recarga no
              servidor para mitigar trapaças e manter fluidez.
            </p>
          </div>

          <div class="border border-border-subtle bg-bg-canvas p-5 space-y-2">
            <div class="font-mono text-[13px] leading-normal text-accent-text">SYS-02 // ÁRVORE DE MUTAÇÕES</div>
            <h3 class="text-base font-semibold text-text-primary">Composição Modular de Atributos</h3>
            <p class="text-[13px] text-text-secondary leading-relaxed">
              Modelagem orientada a dados em Luau onde habilidades e adaptações biológicas alteram atributos base sem
              acoplamento rígido entre classes de criaturas.
            </p>
          </div>

          <div class="border border-border-subtle bg-bg-canvas p-5 space-y-2">
            <div class="font-mono text-[13px] leading-normal text-accent-text">SYS-03 // TELEMETRIA & ENSINO</div>
            <h3 class="text-base font-semibold text-text-primary">Didática Aplicada em Engenharia</h3>
            <p class="text-[13px] text-text-secondary leading-relaxed">
              Experiência prática como tutor na Kodland decompondo máquinas de estado, eventos remotos e lógica em
              Python/Luau para novos desenvolvedores.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 5. EXPERIÊNCIA PROFISSIONAL, PESQUISA E ENSINO -->
    <section id="experiencia" aria-labelledby="experiencia-heading" class="py-16 border-b border-border-subtle space-y-8">
      <div class="space-y-2">
        <span class="font-mono text-[13px] leading-normal uppercase tracking-wider text-accent-text block">
          03. Experiência Profissional, Pesquisa & Ensino
        </span>
        <h2 id="experiencia-heading" class="text-2xl sm:text-3xl font-semibold tracking-[-0.015em] text-text-primary">
          Trajetória Cronológica Verificada (2023 — 2026)
        </h2>
      </div>

      <div class="space-y-4">
        {
          experiences.map((exp) => (
            <article class="border border-border-subtle bg-bg-surface p-6 grid grid-cols-1 lg:grid-cols-12 gap-4 items-start">
              <div class="lg:col-span-4 space-y-1">
                <div class="font-mono text-[13px] leading-normal text-metric-accent font-medium">{exp.period}</div>
                <div class="text-base font-semibold text-text-primary">{exp.org}</div>
                <div class="font-mono text-[13px] leading-normal text-accent-text">{exp.tag}</div>
              </div>

              <div class="lg:col-span-8 space-y-2">
                <h3 class="text-lg font-semibold text-text-primary">{exp.role}</h3>
                <p class="text-sm text-text-secondary leading-relaxed">{exp.description}</p>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- 6. PRÉVIA DO TECH JOURNAL -->
    <section id="journal" aria-labelledby="journal-heading" class="py-16 border-b border-border-subtle space-y-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <div class="space-y-2">
          <span class="font-mono text-[13px] leading-normal uppercase tracking-wider text-accent-text block">
            04. Tech Journal — Cadernos de Engenharia & Pesquisa
          </span>
          <h2 id="journal-heading" class="text-2xl sm:text-3xl font-semibold tracking-[-0.015em] text-text-primary">
            Artigos Técnicos e Memória de Arquitetura
          </h2>
        </div>
        <span class="font-mono text-[13px] leading-normal text-text-secondary">
          LEITURA PROFUNDA PREVISTA PARA A FASE 5
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {
          journalPreviews.map((post) => (
            <article class="border border-border-subtle bg-bg-surface p-6 flex flex-col justify-between space-y-5">
              <div class="space-y-3">
                <div class="flex items-center justify-between font-mono text-[13px] leading-normal">
                  <span class="text-accent-text">{post.code}</span>
                  <span class="text-text-secondary">{post.category}</span>
                </div>
                <h3 class="text-base font-semibold text-text-primary leading-snug">{post.title}</h3>
                <p class="text-[13px] text-text-secondary leading-relaxed">{post.excerpt}</p>
              </div>

              <div class="pt-4 border-t border-border-subtle font-mono text-[13px] leading-normal text-metric-accent">
                {post.meta}
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- 7. COMPETÊNCIAS TÉCNICAS -->
    <section id="competencias" aria-labelledby="competencias-heading" class="py-16 border-b border-border-subtle space-y-8">
      <div class="space-y-2">
        <span class="font-mono text-[13px] leading-normal uppercase tracking-wider text-accent-text block">
          05. Competências Técnicas & Ferramentas
        </span>
        <h2 id="competencias-heading" class="text-2xl sm:text-3xl font-semibold tracking-[-0.015em] text-text-primary">
          Stack Tecnológico por Domínio de Atuação
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {
          skillGroups.map((group) => (
            <div class="border border-border-subtle bg-bg-surface p-5 space-y-4">
              <div class="border-b border-border-subtle pb-3">
                <div class="font-mono text-[13px] leading-normal text-accent-text">{group.code}</div>
                <h3 class="text-base font-semibold text-text-primary mt-0.5">{group.title}</h3>
              </div>

              <ul class="space-y-2 text-[13px] leading-normal font-mono text-text-secondary">
                {group.items.map((item) => (
                  <li class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 bg-metric-accent shrink-0" aria-hidden="true" />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>


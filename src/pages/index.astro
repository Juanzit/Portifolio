---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

const featuredProjects = [
  {
    context: 'Desenvolvimento Mobile · Projeto de Extensão (IF Sudeste MG)',
    period: '2024 — 2026',
    title: 'ShapeMeApp',
    subtitle: 'Ecossistema mobile e web para acompanhamento de treinos, avaliação física e prevenção de lesões.',
    description:
      'Desenvolvido no projeto de extensão "Emagreça na Musculação no IF Sudeste MG — Campus Rio Pomba", reúne três aplicações integradas (Aluno, Professor e Coordenador) e versão web com Expo Router. Atuei na evolução em React Native, modelagem NoSQL no Firebase, cálculo de métricas de carga (CIT, Monotonia e Strain), testes de usabilidade e QA.',
    highlight: 'Apresentado no VII SIMEPE (2025) · Monorepo com módulos Aluno, Professor e Coordenador',
    stack: ['React Native', 'Expo SDK', 'Firebase Auth', 'Cloud Firestore', 'AsyncStorage', 'Expo Router'],
    links: [
      { label: 'Repositório Monorepo no GitHub ↗', href: 'https://github.com/Juanzit/ShapeMeApp', external: true },
      { label: 'Versão Web (SmaAlunoWeb) ↗', href: 'https://github.com/Juanzit/SmaAlunoWeb', external: true },
    ],
    visualStatus: 'Capturas reais das telas do aplicativo em preparação para o estudo de caso.',
  },
  {
    context: 'Desenvolvimento Web · Projeto Comercial em Produção',
    period: '2025 — 2026',
    title: 'Lundgren Atelier',
    subtitle: 'Plataforma digital comercial em produção com gerenciamento de conteúdo headless.',
    description:
      'Desenvolvimento e publicação do site oficial do Lundgren Atelier, estruturado com geração estática em Astro, integração com Sanity.io (Headless CMS) para gestão de acervo, estilização responsiva em Tailwind CSS, scripts automatizados em Node.js para migração de conteúdo e deploy contínuo via Cloudflare Pages.',
    highlight: 'Em produção com domínio próprio · Arquitetura estática e Headless CMS',
    stack: ['Astro', 'Sanity.io', 'Tailwind CSS', 'Node.js', 'Cloudflare Pages'],
    links: [{ label: 'Acessar lundgren-atelier.com ↗', href: 'https://lundgren-atelier.com/', external: true }],
    visualStatus: 'Aplicação comercial ativa em produção.',
  },
  {
    context: 'Inteligência Artificial & Processamento de Sinais · Pesquisa Científica',
    period: '2025 — 2026',
    title: 'Detecção Acústica de Aves Ameaçadas Utilizando Aprendizado de Máquina',
    subtitle: 'Comparação experimental de arquiteturas supervisionadas sobre vocalizações de 136 espécies ameaçadas.',
    description:
      'Pesquisa de iniciação científica e TCC desenvolvida no IF Sudeste MG em coautoria com Maurício Archanjo Nunes Coelho. Avaliamos a extração de Espectrogramas Mel e coeficientes MFCC sobre gravações do repositório Xeno-Canto, comparando SVM (MVS), GMM-HMM (MOM) e Redes Neurais Convolucionais (CNN / RNC) entre o Cenário A (Controle) e o Cenário B (Proposto).',
    highlight: 'CNN no Cenário B (Proposto): F1-weighted de 0,82 · Publicado nos Anais do VII CoBICET (ISSN 2764-0582)',
    stack: ['Python', 'CNN (RNC)', 'SVM (MVS)', 'GMM-HMM (MOM)', 'Espectrogramas Mel & MFCC', 'Xeno-Canto'],
    links: [{ label: 'Registro no Currículo Lattes ↗', href: 'http://lattes.cnpq.br/9434044887106048', external: true }],
    visualStatus: 'Repositório público do código e figuras experimentais em organização para publicação.',
  },
  {
    context: 'Game Development · Projeto Autoral em Desenvolvimento',
    period: 'Em desenvolvimento',
    title: 'Núcleo Selvagem',
    subtitle: 'Roguelite autoral de criaturas mutantes com expedições, evolução genética e Base Pessoal 2.0.',
    description:
      'Jogo autoral em desenvolvimento no Roblox Studio utilizando programação modular em Luau e modelagem 3D no Blender. O projeto estrutura sistemas de incursão roguelite, combinação de mutações e atributos adaptativos de criaturas, além de persistência e gerenciamento da Base Pessoal 2.0.',
    highlight: 'Arquitetura modular de sistemas de jogo em Luau e assets 3D autorais no Blender',
    stack: ['Roblox Studio', 'Luau', 'Blender (Modelagem 3D)', 'Sistemas de Jogo', 'Arquitetura Modular'],
    links: [{ label: 'Solicitar demonstração técnica ↓', href: '#contato', external: false }],
    visualStatus: 'Capturas do jogo no Roblox Studio e modelos 3D em preparação.',
  },
];

const githubCategories = [
  {
    category: 'Desenvolvimento e Programação',
    description: 'Projetos autorais de software e jogos com código-fonte completo e documentação.',
    items: [
      {
        title: 'Blade of Albaia',
        meta: 'Python · Pygame Zero · POO & Física Vetorial',
        summary:
          'Jogo de plataforma 2D autoral desenvolvido para o processo seletivo da Kodland. Implementa física de pulo, inimigos com padrões de movimento, plataformas móveis, coleta de fragmentos, múltiplas telas (menu, introdução, fases e game over) e controle de áudio.',
        href: 'https://github.com/Juanzit/Blade_of_Albaia',
        linkLabel: 'Ver repositório no GitHub ↗',
      },
    ],
  },
  {
    category: 'Projetos Colaborativos',
    description: 'Sistemas desenvolvidos em coautoria com atribuição explícita de responsabilidades.',
    items: [
      {
        title: 'ArchFlow — Sistema de Gerenciamento Arquitetônico (LPS)',
        meta: 'Java 17 · Maven · Hibernate/JPA · MySQL · Swing/FlatLaf · JavaFX 3D',
        coauthors: 'Coautoria: Victor Emanuel (Victorlolmi, proprietário do repositório) e Juan Silva Garcia',
        summary:
          'Sistema desktop para gestão de projetos arquitetônicos, terrenos, orçamento de despesas, documentos, feedbacks e visualização 3D. Minha participação incluiu a refatoração da arquitetura MVC, controle de acesso entre gestores e clientes, validações e tratamento de exceções, fluxo de recuperação de senha e organização dos diagramas UML e documentação de requisitos.',
        href: 'https://github.com/Victorlolmi/LPS_Sistema_de_Gerenciamento_Arquitetonico',
        linkLabel: 'Repositório original (Victorlolmi) ↗',
      },
    ],
  },
  {
    category: 'Pesquisa e Projetos Acadêmicos',
    description: 'Algoritmos de otimização, teoria dos grafos e engenharia de software desenvolvidos na graduação.',
    items: [
      {
        title: 'PCMRC — Caminho Mínimo com Restrição de Recursos',
        meta: 'Java · Simulated Annealing · Pesquisa Operacional',
        summary:
          'Implementação da meta-heurística Simulated Annealing (Têmpera Simulada) com operador de vizinhança Cut-and-Reconnect e gerador automático de instâncias de benchmark para resolver o Problema do Caminho Mínimo com Restrição de Recursos em grafos.',
        href: 'https://github.com/Juanzit/Problema-do-Caminho-M-nimo-com-Restri-es-de-Recursos-PCMRC-',
        linkLabel: 'Ver repositório no GitHub ↗',
      },
      {
        title: 'Viga-Mestre — Engenharia de Requisitos & Modelagem UML',
        meta: 'Engenharia de Software · Arquitetura & 16 Diagramas UML',
        summary:
          'Modelagem completa do ciclo de vida de empreendimentos imobiliários (da aquisição do terreno à execução e venda de unidades), composta por Documento de Requisitos e 16 diagramas UML (Classes, Caso de Uso, Sequência, Estado, Atividade, Implantação e Gantt).',
        href: 'https://github.com/Juanzit/Viga-Mestre',
        linkLabel: 'Ver diagramas e documentação ↗',
      },
      {
        title: 'Emparelhamento Máximo em Grafos (Hopcroft-Karp)',
        meta: 'Python · C++ · Teoria dos Grafos & Redes Complexas',
        summary:
          'Implementação do algoritmo de Hopcroft-Karp para correspondências máximas em grafos bipartidos e conversão de grafos direcionados para identificação de nós de controle em redes complexas.',
        href: 'https://github.com/Juanzit/Trabalho-grafos',
        linkLabel: 'Ver repositório no GitHub ↗',
      },
    ],
  },
  {
    category: 'Ensino e Comunidade',
    description: 'Materiais didáticos abertos, videoaulas e iniciativas de extensão universitária.',
    items: [
      {
        title: 'Minicurso React Native — Do Zero ao APK',
        meta: 'JavaScript · React Native · Produção de 16 Videoaulas',
        summary:
          'Série aberta de 16 videoaulas práticas ensinando desenvolvimento mobile com JavaScript e React Native desde a configuração do ambiente até a geração do APK, produzida em projeto de extensão no IF Sudeste MG.',
        href: 'https://www.youtube.com/@CURSORNFIRP',
        linkLabel: 'Assistir canal no YouTube ↗',
      },
      {
        title: 'Roadmap Python',
        meta: 'Python · Comunidade Acadêmica & Materiais de Estudo',
        summary:
          'Iniciativa acadêmica voltada ao compartilhamento de trilhas de estudo, códigos comentados e aulas abertas sobre programação em Python.',
        href: 'https://github.com/RoadMapPython',
        linkLabel: 'Acessar organização no GitHub ↗',
      },
    ],
  },
];

const experiences = [
  {
    period: '04/2026 — Atual',
    role: 'Professor Tutor de Programação e Tecnologia',
    org: 'CNA Digital',
    meta: '15h semanais',
    description:
      'Condução de trilhas de lógica de programação, Scratch, Construct, modelagem 3D com Blender e SculptGL, Unity, Roblox Studio, React, Python, Ciência de Dados e Inteligência Artificial.',
  },
  {
    period: '06/2025 — Atual',
    role: 'Professor Tutor de Programação (Python, Lua & Scratch)',
    org: 'Kodland',
    meta: '12h semanais · EdTech Internacional',
    description:
      'Ensino prático para alunos de 8 a 16 anos em Scratch, Python (Flask, POO e bancos de dados) e Roblox Studio/Lua, aplicando aprendizagem baseada em projetos (PBL), Scrum e Git/GitHub.',
  },
  {
    period: '06/2025 — 06/2026',
    role: 'Pesquisador em Inteligência Artificial',
    org: 'IF Sudeste MG — Campus Rio Pomba',
    meta: 'Iniciação Científica',
    description:
      'Desenvolvimento de pipelines de pré-processamento acústico e modelos supervisionados (CNN/RNC, SVM/MVS e GMM-HMM/MOM) para identificação automática de 136 espécies de aves ameaçadas de extinção.',
  },
  {
    period: '08/2024 — 01/2026',
    role: 'Desenvolvedor Mobile Júnior — Projeto ShapeMeApp',
    org: 'IF Sudeste MG — Campus Rio Pomba',
    meta: 'Projeto de Extensão',
    description:
      'Atuação no projeto "Emagreça na Musculação no IF Sudeste MG — Campus Rio Pomba", realizando evolução mobile em React Native/Expo, modelagem NoSQL no Firebase, testes de usabilidade, QA e gestão com Jira e GitHub.',
  },
  {
    period: '06/2022 — 11/2025',
    role: 'Membro de Projetos, Validação e Prototipação',
    org: 'EmComp — Empresa Júnior de Computação (IF Sudeste MG)',
    meta: '100 horas certificadas',
    description:
      'Desenvolvimento web (incluindo o site institucional da Labclin), prototipação de sites e aplicativos, validação de UX/UI e organização de eventos técnicos junto ao Núcleo da Mata.',
  },
];

const education = [
  {
    period: '2022 — Em andamento',
    degree: 'Bacharelado em Ciência da Computação',
    institution: 'Instituto Federal do Sudeste de Minas Gerais (IF Sudeste MG — Campus Rio Pomba)',
    detail: 'Pesquisa aplicada em Inteligência Artificial, engenharia de software, estruturas de dados, grafos e desenvolvimento mobile/web.',
  },
  {
    period: '2019 — 2021 (Registro Lattes: 2019 — 2022)',
    degree: 'Técnico em Informática',
    institution: 'Instituto Federal do Sudeste de Minas Gerais (IF Sudeste MG — Campus Rio Pomba)',
    detail: 'Formação técnica de base em lógica de programação, redes, bancos de dados, manutenção e desenvolvimento de sistemas.',
  },
];

const publications = [
  {
    year: '05/08/2026',
    type: 'Trabalho Completo Publicado em Anais · ISSN 2764-0582',
    title: 'Detecção Acústica de Aves Ameaçadas Utilizando Aprendizado de Máquina',
    venue: 'Anais do VII Congresso Brasileiro Interdisciplinar em Ciência e Tecnologia (VII CoBICET) — Editora Even3',
    authors: 'Autores: Juan Silva Garcia e Maurício Archanjo Nunes Coelho (GARCIA, J. S.; COELHO, M. A. N.)',
  },
  {
    year: '2026',
    type: 'Apresentação de Trabalho Científico',
    title: 'Detecção Acústica de Aves Ameaçadas Utilizando Aprendizado de Máquina',
    venue: 'XVIII Encontro Acadêmico de Modelagem Computacional (EAMC)',
    authors: 'Autores: Juan Silva Garcia e Maurício Archanjo Nunes Coelho',
  },
  {
    year: '2025',
    type: 'Trabalho Apresentado em Simpósio Institucional',
    title: 'Evolução de Software em Ambientes Acadêmicos: O ShapeMeApp e a Integração de Feedbacks Reais no Campus Rio Pomba',
    venue: 'VII Simpósio de Ensino, Pesquisa e Extensão (VII SIMEPE) — IF Sudeste MG',
    authors: 'Autores: Juan Silva Garcia, Gustavo Vaz Teixeira, Sérgio Muinhos Barroso Lima e João Batista Ferreira Júnior',
  },
];

const certificationsAndExtension = [
  {
    period: '2022 — 2025',
    title: 'Certificação de Atuação em Empresa Júnior (EmComp)',
    issuer: 'IF Sudeste MG — Campus Rio Pomba',
    workload: '100 horas certificadas',
  },
  {
    period: '03/2025 — 08/2025',
    title: 'Monitoria Voluntária — Linguagens Formais e Autômatos',
    issuer: 'IF Sudeste MG — Campus Rio Pomba',
    workload: 'Ensino superior',
  },
  {
    period: '2025',
    title: 'Ministrante de Minicurso Presencial: React com Firebase',
    issuer: 'IF Sudeste MG — Campus Rio Pomba',
    workload: 'Formação prática',
  },
  {
    period: '12/2023 — 08/2024',
    title: 'Instrutor de Desenvolvimento Mobile (JavaScript & React Native)',
    issuer: 'IF Sudeste MG — Projeto de Extensão',
    workload: '16 videoaulas gravadas',
  },
  {
    period: '2020',
    title: 'Voluntário no Curso "Python Básico pra Quem Tem Pressa"',
    issuer: 'IF Sudeste MG — Projeto de Extensão',
    workload: 'Extensão comunitária',
  },
];
---

<BaseLayout
  title="Juan Silva Garcia — Desenvolvimento de Software, Pesquisa em IA & Jogos"
  description="Portfólio pessoal e acadêmico de Juan Silva Garcia (GARCIA, J. S.). Graduando em Ciência da Computação e Técnico em Informática pelo IF Sudeste MG (Campus Rio Pomba), com atuação em desenvolvimento mobile e web, pesquisa em IA aplicada à bioacústica, criação de jogos e ensino de programação."
>
  <Header />

  <main id="main-content" tabindex="-1" class="max-w-[1120px] mx-auto px-4 sm:px-8">
    <!-- 1. HERO SECTION -->
    <section aria-labelledby="hero-heading" class="py-14 sm:py-20 border-b border-border-subtle">
      <p class="text-[13px] leading-normal font-mono text-accent-text mb-4">
        Cataguases, MG · IF Sudeste MG (Campus Rio Pomba)
      </p>

      <h1
        id="hero-heading"
        class="text-3xl sm:text-5xl font-bold tracking-[-0.025em] text-text-primary leading-[1.14] max-w-[26ch]"
      >
        Olá, eu sou o Juan. Desenvolvo software, pesquiso aprendizado de máquina e crio jogos e experiências interativas.
      </h1>

      <div class="mt-6 space-y-4 text-base sm:text-lg text-text-secondary leading-[1.68] max-w-[66ch]">
        <p>
          Sou graduando em <strong class="text-text-primary font-medium">Ciência da Computação</strong> e <strong class="text-text-primary font-medium">Técnico em Informática</strong> pelo IF Sudeste MG — Campus Rio Pomba. Trabalho no desenvolvimento de aplicações mobile e web, na pesquisa em inteligência artificial aplicada ao processamento de sinais bioacústicos e na criação de jogos e sistemas interativos.
        </p>
        <p class="text-sm sm:text-base">
          Paralelamente à engenharia de software e à pesquisa acadêmica, atuo como professor tutor na <strong class="text-text-primary font-medium">CNA Digital</strong> e na <strong class="text-text-primary font-medium">Kodland</strong>, ensinando programação em Python, React, desenvolvimento de jogos (Roblox Studio/Luau e Unity), modelagem 3D e fundamentos de IA.
        </p>
      </div>

      <div class="mt-8 flex flex-wrap items-center gap-3.5">
        <a
          href="#projetos"
          class="min-h-[44px] px-6 py-2.5 inline-flex items-center justify-center bg-accent-solid hover:bg-accent-solid-hover text-white font-medium text-sm transition-colors"
        >
          Ver Projetos Principais
        </a>
        <a
          href="#github"
          class="min-h-[44px] px-6 py-2.5 inline-flex items-center justify-center bg-bg-surface hover:bg-bg-elevated text-text-primary border border-border-control hover:border-accent-text font-medium text-sm transition-colors"
        >
          Explorar GitHub & Colaborações
        </a>
        <a
          href="#contato"
          class="min-h-[44px] px-4 py-2.5 inline-flex items-center justify-center text-sm text-accent-text hover:underline"
        >
          Entrar em contato →
        </a>
      </div>
    </section>

    <!-- 2. QUATRO PROJETOS PRINCIPAIS EM DESTAQUE -->
    <section id="projetos" aria-labelledby="projetos-heading" class="py-16 border-b border-border-subtle space-y-8">
      <div class="space-y-2 max-w-[65ch]">
        <p class="text-[13px] leading-normal font-mono text-accent-text">Trabalhos em Destaque</p>
        <h2 id="projetos-heading" class="text-2xl sm:text-3xl font-semibold tracking-[-0.015em] text-text-primary">
          Projetos principais em mobile, web, pesquisa em IA e jogos
        </h2>
        <p class="text-sm sm:text-base text-text-secondary leading-relaxed">
          Quatro projetos que sintetizam minha atuação prática entre engenharia de aplicações, pesquisa científica
          publicada e desenvolvimento de sistemas interativos.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {
          featuredProjects.map((project) => (
            <article class="border border-border-subtle bg-bg-surface hover:border-accent-primary transition-colors p-6 sm:p-7 flex flex-col justify-between space-y-6">
              <div class="space-y-3.5">
                <div class="flex flex-wrap items-center justify-between gap-2 text-[13px] leading-normal">
                  <span class="text-accent-text font-medium">{project.context}</span>
                  <span class="font-mono text-text-secondary">{project.period}</span>
                </div>

                <h3 class="text-xl sm:text-2xl font-semibold text-text-primary leading-snug">{project.title}</h3>

                <p class="text-sm font-medium text-text-primary/90 leading-snug">{project.subtitle}</p>

                <p class="text-sm text-text-secondary leading-relaxed">{project.description}</p>
              </div>

              <div class="space-y-4 pt-4 border-t border-border-subtle">
                <p class="text-[13px] leading-normal font-mono text-metric-accent">{project.highlight}</p>

                <div class="flex flex-wrap gap-1.5">
                  {project.stack.map((tech) => (
                    <span class="px-2.5 py-1 bg-bg-canvas border border-border-subtle text-[13px] leading-normal font-mono text-text-secondary">
                      {tech}
                    </span>
                  ))}
                </div>

                <div class="pt-1 flex flex-wrap items-center justify-between gap-3">
                  <div class="flex flex-wrap items-center gap-4">
                    {project.links.map((link) => (
                      <a
                        href={link.href}
                        target={link.external ? '_blank' : undefined}
                        rel={link.external ? 'noopener noreferrer' : undefined}
                        class="min-h-[44px] inline-flex items-center text-sm font-medium text-accent-text hover:underline"
                      >
                        {link.label}
                      </a>
                    ))}
                  </div>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- 3. EXPLORANDO MEU GITHUB, PESQUISA, COLABORAÇÕES & COMUNIDADE -->
    <section id="github" aria-labelledby="github-heading" class="py-16 border-b border-border-subtle space-y-10">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <div class="space-y-2 max-w-[65ch]">
          <p class="text-[13px] leading-normal font-mono text-accent-text">Repositórios, Pesquisa & Comunidade</p>
          <h2 id="github-heading" class="text-2xl sm:text-3xl font-semibold tracking-[-0.015em] text-text-primary">
            Outros projetos por área de atuação
          </h2>
          <p class="text-sm sm:text-base text-text-secondary leading-relaxed">
            Curadoria de repositórios públicos, sistemas desenvolvidos em parceria, implementações de algoritmos e
            materiais abertos de ensino.
          </p>
        </div>

        <a
          href="https://github.com/Juanzit"
          target="_blank"
          rel="noopener noreferrer"
          class="min-h-[44px] px-4 py-2 inline-flex items-center border border-border-control bg-bg-surface hover:border-accent-text text-sm font-mono text-text-primary transition-colors shrink-0"
        >
          github.com/Juanzit ↗
        </a>
      </div>

      <div class="space-y-10">
        {
          githubCategories.map((group) => (
            <div class="space-y-4">
              <div class="border-b border-border-subtle pb-2.5 flex flex-col sm:flex-row sm:items-baseline justify-between gap-2">
                <h3 class="text-lg font-semibold text-text-primary">{group.category}</h3>
                <p class="text-[13px] leading-normal text-text-secondary">{group.description}</p>
              </div>

              <div
                class:list={[
                  'grid grid-cols-1 gap-5',
                  group.items.length > 1 ? 'md:grid-cols-2 lg:grid-cols-3' : 'md:grid-cols-1',
                ]}
              >
                {group.items.map((item) => (
                  <article class="border border-border-subtle bg-bg-surface p-5 flex flex-col justify-between space-y-4">
                    <div class="space-y-2.5">
                      <div class="text-[13px] leading-normal font-mono text-accent-text">{item.meta}</div>
                      <h4 class="text-base font-semibold text-text-primary leading-snug">{item.title}</h4>
                      {'coauthors' in item && item.coauthors && (
                        <p class="text-[13px] leading-normal font-mono text-metric-accent">{item.coauthors}</p>
                      )}
                      <p class="text-sm text-text-secondary leading-relaxed">{item.summary}</p>
                    </div>

                    <div class="pt-3 border-t border-border-subtle">
                      <a
                        href={item.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="min-h-[44px] inline-flex items-center text-sm font-medium text-accent-text hover:underline"
                      >
                        {item.linkLabel}
                      </a>
                    </div>
                  </article>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- 4. EXPERIÊNCIA PROFISSIONAL -->
    <section id="trajetoria" aria-labelledby="trajetoria-heading" class="py-16 border-b border-border-subtle space-y-8">
      <div class="space-y-2 max-w-[65ch]">
        <p class="text-[13px] leading-normal font-mono text-accent-text">Atuação Profissional & Acadêmica</p>
        <h2 id="trajetoria-heading" class="text-2xl sm:text-3xl font-semibold tracking-[-0.015em] text-text-primary">
          Experiência profissional, pesquisa e ensino
        </h2>
      </div>

      <div class="divide-y divide-border-subtle border border-border-subtle bg-bg-surface">
        {
          experiences.map((exp) => (

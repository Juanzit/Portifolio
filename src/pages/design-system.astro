---
import BaseLayout from '../layouts/BaseLayout.astro';
import KineticHeading from '../components/ui/KineticHeading.astro';
import ArcadeButton from '../components/ui/ArcadeButton.astro';
import MangaPanel from '../components/ui/MangaPanel.astro';
import PerspectiveCard from '../components/ui/PerspectiveCard.astro';
import GraphicMarquee from '../components/ui/GraphicMarquee.astro';
import Badge from '../components/ui/Badge.astro';
import Tabs, { type TabItem } from '../components/ui/Tabs.astro';

// Auditoria cromática do sistema NEON GENESIS EVANGELION // EVA-01 TACTICAL INTERFACE
const eva01Tokens = [
  {
    name: 'bg-canvas',
    cssVar: '--bg-canvas',
    hexDark: '#0A0812',
    hexLight: '#F2EFF6',
    role: 'Void Black — Fundo principal mineral / Canvas editorial claro',
    contrastDark: '17.77:1 vs #F4F1F7 (AAA)',
    sampleClass: 'bg-bg-canvas',
  },
  {
    name: 'bg-surface',
    cssVar: '--bg-surface',
    hexDark: '#15111F',
    hexLight: '#FFFFFF',
    role: 'Deep Unit — Superfícies, Header e Cards estruturais',
    contrastDark: '16.12:1 vs #F4F1F7 (AAA)',
    sampleClass: 'bg-bg-surface',
  },
  {
    name: 'bg-panel',
    cssVar: '--bg-panel',
    hexDark: '#211A2B',
    hexLight: '#E9E3F0',
    role: 'Mecha Panel — Painéis de dados, caixas de código e sub-containers',
    contrastDark: '14.50:1 vs #F4F1F7 (AAA)',
    sampleClass: 'bg-bg-panel',
  },
  {
    name: 'eva-purple',
    cssVar: '--eva-purple',
    hexDark: '#7047A3',
    hexLight: '#62408E',
    role: 'Eva Purple — Roxo dominante da armadura do EVA-01',
    contrastDark: '6.73:1 vs #FFFFFF (AA)',
    sampleClass: 'bg-eva-purple',
  },
  {
    name: 'eva-purple-light',
    cssVar: '--eva-purple-light',
    hexDark: '#B99BE8',
    hexLight: '#62408E',
    role: 'Violet Energy — Detalhes, palavras destacadas e numerações',
    contrastDark: '7.88:1 vs #211A2B (AAA)',
    sampleClass: 'bg-eva-purple-light',
  },
  {
    name: 'accent-volt',
    cssVar: '--accent-volt',
    hexDark: '#C6F542',
    hexLight: '#496500',
    role: 'Acid Volt — CTAs principais, status ATIVO e telemetria viva',
    contrastDark: '15.66:1 vs #0A0812 (AAA)',
    sampleClass: 'bg-accent-volt',
  },
  {
    name: 'accent-alert',
    cssVar: '--accent-alert',
    hexDark: '#FF9B54',
    hexLight: '#A4460B',
    role: 'NERV Alert — Avisos operacionais, advertências e destaques especiais',
    contrastDark: '9.53:1 vs #0A0812 (AAA)',
    sampleClass: 'bg-accent-alert',
  },
  {
    name: 'text-primary',
    cssVar: '--text-primary',
    hexDark: '#F4F1F7',
    hexLight: '#191321',
    role: 'LCL White — Leitura principal e títulos de alta clareza',
    contrastDark: '17.77:1 vs #0A0812 (AAA)',
    sampleClass: 'bg-text-primary',
  },
];

const evaSpecs: TabItem[] = [
  {
    id: 'spec-eva-01',
    code: '01.',
    label: 'Hierarquia Cromática',
    content:
      'Roxo como identidade estrutural da armadura do EVA-01, verde fluorescente contido em ações e status importantes, e laranja restrito a alertas operacionais da NERV.',
    metricLabel: 'DESIGN LANGUAGE',
    metrics: 'EVA-01 Tactical Violet',
    metricTone: 'metric',
  },
  {
    id: 'spec-eva-02',
    code: '02.',
    label: 'Regra de Ouro UX',
    content:
      'Cada componente possui um elemento visual dominante e no máximo dois decorativos secundários, eliminando a poluição visual.',
    metricLabel: 'CONTROLE DE RUÍDO',
    metrics: '1 Dominante + 2 Secundários',
    metricTone: 'accent',
  },
  {
    id: 'spec-eva-03',
    code: '03.',
    label: 'Cyber Light Seguro',
    content:
      'Adaptação semântica com #496500 para textos verdes (5.2:1 AAA) e verde fluorescente #C6F542 para preenchimento de botões com texto escuro.',
    metricLabel: 'ACSIBILIDADE WCAG',
    metrics: 'Conformidade 2.1 AA / AAA',
    metricTone: 'metric',
  },
];
---

<BaseLayout
  title="Design System — EVA-01 Tactical Interface | Juan Silva Garcia"
  description="Especificação visual e sistema de componentes EVA-01 Tactical Violet do portfólio de engenharia de software de Juan Silva Garcia."
>
  <div class="min-h-screen">
    <!-- Header do Design System -->
    <header class="border-b-2 border-border-subtle bg-bg-surface/90 backdrop-blur-md sticky top-0 z-40">
      <div class="max-w-[1200px] mx-auto px-4 sm:px-8 min-h-16 py-2 flex flex-wrap items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <span class="font-mono text-xs px-2.5 py-1 bg-eva-purple text-text-primary font-bold uppercase tracking-wider manga-tag-chamfer shadow-hard-solid">
            SYS.DS // EVA-01
          </span>
          <span class="font-display font-black text-sm tracking-tight text-text-primary">
            JUAN SILVA GARCIA
          </span>
        </div>
        <nav aria-label="Seções do Design System" class="flex flex-wrap items-center gap-3 text-xs font-mono">
          <a href="#tokens" class="min-h-[44px] px-2 inline-flex items-center text-text-secondary hover:text-accent-volt transition-colors font-bold">
            01. TOKENS
          </a>
          <a href="#tipografia" class="min-h-[44px] px-2 inline-flex items-center text-text-secondary hover:text-accent-volt transition-colors font-bold">
            02. TIPOGRAFIA
          </a>
          <a href="#componentes" class="min-h-[44px] px-2 inline-flex items-center text-text-secondary hover:text-accent-volt transition-colors font-bold">
            03. BOTÕES HIERÁRQUICOS
          </a>
          <a href="#cards-3d" class="min-h-[44px] px-2 inline-flex items-center text-text-secondary hover:text-accent-volt transition-colors font-bold">
            04. DECK MECHA
          </a>
        </nav>
      </div>
    </header>

    <main id="main-content" tabindex="-1" class="max-w-[1200px] mx-auto px-4 sm:px-8 py-12 space-y-16 focus:outline-none">
      <!-- Banner Hero do Design System -->
      <section class="border-2 border-border-subtle bg-bg-panel p-6 sm:p-10 relative overflow-hidden shadow-hard-solid">
        <div class="relative z-10 space-y-5">
          <div class="flex flex-wrap items-center gap-2">
            <span class="px-2.5 py-0.5 text-xs font-mono font-bold bg-eva-purple text-text-primary uppercase manga-tag-chamfer">
              PALETA OFICIAL: EVA-01 TACTICAL VIOLET
            </span>
            <span class="px-2.5 py-0.5 text-xs font-mono font-bold bg-accent-volt text-text-on-volt uppercase manga-tag-chamfer">
              NERV ENGINEERING // HUD
            </span>
            <span class="px-2.5 py-0.5 text-xs font-mono font-bold bg-bg-surface border border-border-subtle text-text-secondary uppercase">
              WCAG 2.1 AA / AAA CERTIFIED
            </span>
          </div>
          <h1 class="text-3xl sm:text-5xl font-display font-black tracking-tight text-text-primary uppercase leading-tight">
            Design System // EVA-01 Tactical Interface
          </h1>
          <p class="text-base text-text-secondary max-w-[70ch] leading-relaxed font-sans font-medium">
            Sistema visual autoral inspirado na armadura mecha do Evangelion Unit-01, nas interfaces operacionais dos supercomputadores MAGI da NERV e no rigor editorial de engenharia de software. Roxo mineral dominante, acentos fluorescentes Acid Volt e alertas NERV dedicados.
          </p>
        </div>
      </section>

      <!-- Fita Ticker Contínua Discreta -->
      <GraphicMarquee
        items={[
          'EVA-01 TACTICAL VIOLET',
          'NERV ENGINEERING HUD',
          'ACID VOLT HIGH CONTRAST',
          'MAGI ALERT SYSTEM',
          'WCAG 2.1 AA / AAA COMPLIANT',
          'ZERO EXPENSIVE COMPOSITING',
        ]}
        variant="purple"
      />

      <!-- 01. TOKENS CROMÁTICOS -->
      <section id="tokens" class="space-y-6 scroll-mt-24">
        <KineticHeading
          index="01"
          tag="HUD // 01"
          title="Tokens Cromáticos & Paleta EVA-01"
          description="Roxo como armadura dominante, verde fluorescente contido em ações principais e laranja restrito a alertas operacionais"
          accent="purple"
        />

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {
            eva01Tokens.map((token) => (
              <article class="border-2 border-border-subtle hover:border-eva-purple bg-bg-panel p-4 flex flex-col justify-between space-y-4 shadow-hard-solid transition-colors">
                <div class="flex items-center justify-between gap-3">
                  <div class:list={['w-12 h-12 border-2 border-border-subtle shrink-0 shadow-hard-solid', token.sampleClass]} />
                  <div class="text-right font-mono">
                    <div class="text-xs font-bold text-accent-volt">{token.cssVar}</div>
                    <div class="text-[11px] text-text-secondary mt-0.5">Dark: {token.hexDark}</div>
                    <div class="text-[11px] text-text-secondary">Light: {token.hexLight}</div>
                  </div>
                </div>
                <div class="pt-2 border-t border-border-subtle space-y-1">
                  <div class="text-xs font-bold font-mono text-text-primary uppercase">{token.name}</div>
                  <p class="text-xs text-text-secondary leading-snug">{token.role}</p>
                  <p class="text-[11px] font-mono text-eva-purple-light">{token.contrastDark}</p>
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <!-- 02. ESCALA TIPOGRÁFICA -->
      <section id="tipografia" class="space-y-6 scroll-mt-24">
        <KineticHeading
          index="02"
          tag="HUD // 02"
          title="Matriz Tipográfica Funcional"
          description="Syne para títulos monumentais, Unbounded para contadores mecha, Space Grotesk para leitura técnica e IBM Plex Mono para telemetria"
          accent="purple"
        />

        <div class="border-2 border-border-subtle bg-bg-panel divide-y divide-border-subtle shadow-hard-solid">
          <div class="p-6 space-y-2">
            <span class="text-xs font-mono font-bold text-eva-purple-light">
              DISPLAY 01 // SYNE 900 EXTRA BOLD
            </span>
            <p class="text-3xl sm:text-5xl font-display font-black tracking-tight text-text-primary uppercase">
              JUAN GARCIA // SOFTWARE ENGINEER
            </p>
          </div>

          <div class="p-6 space-y-2">
            <span class="text-xs font-mono font-bold text-accent-volt">
              NUMERAÇÃO HUD // UNBOUNDED 800
            </span>
            <p class="text-2xl sm:text-3xl font-black tracking-tight text-text-primary font-mono uppercase">
              01 // MISSION_DECK: FEATURED_PROJECTS
            </p>
          </div>

          <div class="p-6 space-y-2">
            <span class="text-xs font-mono font-bold text-text-secondary">
              CORPO EDITORIAL // SPACE GROTESK (LEITURA TÉCNICA)
            </span>
            <p class="text-base text-text-secondary leading-relaxed max-w-[70ch] font-sans font-medium">
              Texto corrido com tipografia geométrica humanista para máxima clareza em estudos de caso profundos, notas metodológicas e relatórios de engenharia.
            </p>
          </div>

          <div class="p-6 space-y-2">
            <span class="text-xs font-mono font-bold text-accent-alert">
              TELEMETRIA OPERACIONAL // IBM PLEX MONO (TERMINAL NERV)
            </span>
            <pre class="p-4 bg-bg-surface border border-border-subtle text-xs font-mono text-accent-volt overflow-x-auto shadow-hard-solid"><code>[SYS_STATUS]: EVA-01 READY // SYNCHRONIZATION: 99.4% // MODE: PRODUCTION
EXPERIMENTO_BIOACUSTICA: Cenário A (Controle) vs Cenário B (Proposto)</code></pre>
          </div>
        </div>
      </section>

      <!-- 03. BOTÕES HIERÁRQUICOS DE 3 NÍVEIS -->
      <section id="componentes" class="space-y-6 scroll-mt-24">
        <KineticHeading
          index="03"
          tag="HUD // 03"
          title="Hierarquia de Ações (3 Níveis)"
          description="01 Primary CTA (Acid Volt), 02 Secondary CTA (Eva Purple) e 03 Alert / Special Action (NERV Orange)"
          accent="volt"
        />

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          <!-- Botões EVA-01 -->
          <MangaPanel title="ArcadeButton.astro // Hierarquia Semântica" accent="purple" class="space-y-6">
            <p class="text-xs font-mono text-text-secondary leading-relaxed">
              Botões táteis com chanfro angular a 45 graus, alvo tátil mínimo de 44×44px e anel de foco em Acid Volt. Ao receber clique, geram síntese nativa de som via Web Audio API.
            </p>
            <div class="flex flex-wrap gap-4 items-center">
              <ArcadeButton variant="volt" size="md">
                <span>01 · PRIMARY CTA</span>
                <span aria-hidden="true">►</span>
              </ArcadeButton>

              <ArcadeButton variant="purple" size="md">
                <span>02 · SECONDARY CTA</span>
                <span aria-hidden="true">↗</span>
              </ArcadeButton>

              <ArcadeButton variant="alert" size="md">
                <span>03 · NERV ALERT</span>
                <span aria-hidden="true">!</span>
              </ArcadeButton>

              <ArcadeButton variant="surface" size="md">
                <span>SURFACE BUTTON</span>
              </ArcadeButton>
            </div>

            <div class="pt-4 border-t border-border-subtle space-y-2">
              <span class="text-xs font-mono text-text-secondary uppercase">Tamanhos Disponíveis:</span>
              <div class="flex flex-wrap items-center gap-3">
                <ArcadeButton variant="volt" size="sm">SMALL (SM)</ArcadeButton>
                <ArcadeButton variant="volt" size="md">MEDIUM (MD)</ArcadeButton>
                <ArcadeButton variant="volt" size="lg">LARGE (LG)</ArcadeButton>
              </div>
            </div>
          </MangaPanel>

          <!-- Badges & Tags EVA-01 -->
          <MangaPanel title="Badges Mecha & Alertas Operacionais" accent="purple" class="space-y-6">
            <p class="text-xs font-mono text-text-secondary leading-relaxed">
              Indicadores com alto contraste visual para metadados de tecnologia, status de missão e coautorias de projetos.
            </p>
            <div class="flex flex-wrap gap-2.5">
              <span class="px-2.5 py-1 text-xs font-mono font-bold bg-accent-volt text-text-on-volt uppercase manga-tag-chamfer shadow-hard-solid">
                STATUS: EM PRODUÇÃO
              </span>
              <span class="px-2.5 py-1 text-xs font-mono font-bold bg-eva-purple text-text-primary uppercase manga-tag-chamfer shadow-hard-solid">
                COAUTORIA: LPS (VICTOR EMANUEL)
              </span>
              <span class="px-2.5 py-1 text-xs font-mono font-bold bg-accent-alert text-text-on-volt uppercase manga-tag-chamfer shadow-hard-solid">
                NERV ALERT // VII CoBICET
              </span>
              <Badge variant="neutral">React Native</Badge>
              <Badge variant="neutral">TypeScript</Badge>
              <Badge variant="neutral">Tailwind CSS v4</Badge>
              <Badge variant="neutral">Python / CNN</Badge>
            </div>

            <div class="pt-4 border-t border-border-subtle">
              <Tabs id="eva-tabs" ariaLabel="Especificações EVA-01" tabs={evaSpecs} />
            </div>
          </MangaPanel>
        </div>
      </section>

      <!-- 04. 3D PERSPECTIVE CARDS -->
      <section id="cards-3d" class="space-y-6 scroll-mt-24">
        <KineticHeading
          index="04"
          tag="HUD // 04"
          title="Decks de Missão (3D Tilt Suave)"
          description="Cartões mecha com rotação em perspectiva 3D, reflexo dinâmico de luz e sombras sólidas sem borrão artificial"
          accent="purple"
        />

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <PerspectiveCard maxTilt={5}>
            <div class="space-y-4">
              <div class="flex items-center justify-between">
                <span class="text-xs font-mono text-accent-volt font-bold">MISSION 01 // PRODUCTION</span>
                <span class="text-xs font-mono text-text-secondary">2025 — 2026</span>
              </div>
              <h3 class="font-display font-black text-2xl text-text-primary uppercase">
                Lundgren Atelier
              </h3>
              <p class="text-sm text-text-secondary leading-relaxed font-sans font-medium">
                Vitrine comercial autoral em produção com Astro, Tailwind CSS, Sanity.io e Cloudflare Pages.
              </p>
              <div class="flex items-center justify-between pt-3 border-t border-border-subtle">
                <span class="text-xs font-mono text-eva-purple-light font-bold">STACK: ASTRO / TS / SANITY</span>
                <span class="text-xs font-mono text-text-secondary">CLOUDFLARE</span>
              </div>
            </div>
          </PerspectiveCard>

          <PerspectiveCard maxTilt={5}>
            <div class="space-y-4">
              <div class="flex items-center justify-between">
                <span class="text-xs font-mono text-eva-purple-light font-bold">MISSION 02 // CO-OP</span>
                <span class="text-xs font-mono text-text-secondary">2024</span>
              </div>
              <h3 class="font-display font-black text-2xl text-text-primary uppercase">
                ArchFlow (Coautoria LPS)
              </h3>
              <p class="text-sm text-text-secondary leading-relaxed font-sans font-medium">
                Sistema modular de engenharia de software em Java 17 com JPA e JavaFX 3D em coautoria com Victor Emanuel.
              </p>
              <div class="flex items-center justify-between pt-3 border-t border-border-subtle">
                <span class="text-xs font-mono text-accent-volt font-bold">GITHUB OPEN REPO</span>
                <span class="text-xs font-mono text-text-secondary">JAVA 17</span>
              </div>
            </div>
          </PerspectiveCard>
        </div>
      </section>
    </main>
  </div>
</BaseLayout>
